          "type": [
            "string",
            "null"
          ]
        },
        "baseline_actual_reply_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
