      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "source_record_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "source_id",
        "source_record_sha256"
      ],
      "additionalProperties": false
    },
    "event_time": {
