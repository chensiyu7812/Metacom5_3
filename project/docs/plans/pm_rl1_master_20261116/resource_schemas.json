          "type": "string",
          "minLength": 1
        },
        "actual_reply_sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "resource_record_ids": {
          "type": "array",
