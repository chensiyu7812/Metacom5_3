{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pmrl1:resource-contract:20261116:v1",
  "title": "PM-RL1 versioned resource storage records",
  "description": "DESIGN CONTRACT, not runtime implementation. Source hashes, cross-record references, exact spans, chronology, source-family separation, semantics and Observation projection require separate validators. Validate with format checks enabled. Evaluation/gold/future/outcome information must never become retrievable resources, regardless of acquisition status.",
  "oneOf": [
    {
      "$ref": "#/$defs/source_record"
    },
    {
      "$ref": "#/$defs/resource_record"
    },
    {
      "$ref": "#/$defs/provenance_record"
    },
    {
      "$ref": "#/$defs/index_record"
    },
    {
      "$ref": "#/$defs/evaluation_record"
    }
  ],
  "$defs": {
