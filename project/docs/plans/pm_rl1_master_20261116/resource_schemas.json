      "required": [
        "record_type",
        "schema_version",
        "record_id",
        "record_sha256",
        "experiment_identity",
        "prefix_identity",
        "request_identity",
        "actual_reply_sha256",
        "resource_record_ids",
        "protocol_identity",
        "rater_identity",
        "status",
        "judgment",
        "score",
        "rationale",
        "audience",
        "measurement_mode",
        "baseline_request_identity",
        "baseline_actual_reply_sha256",
        "semantic_review_round"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "pending_generation",
                  "pending_score",
                  "invalid"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "score": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "pending_generation"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "actual_reply_sha256": {
                "type": "null"
              },
              "judgment": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "measured"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "actual_reply_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "anyOf": [
              {
                "properties": {
                  "score": {
                    "type": "number"
                  }
                }
              },
              {
                "properties": {
                  "judgment": {
                    "enum": [
                      "better",
                      "equivalent",
                      "worse"
                    ]
                  }
                }
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "pending_score"
              }
            }
          },
          "then": {
            "properties": {
              "actual_reply_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "judgment": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "measurement_mode": {
                "const": "absolute"
              }
            }
          },
          "then": {
            "properties": {
              "baseline_request_identity": {
                "type": "null"
              },
              "baseline_actual_reply_sha256": {
                "type": "null"
              },
              "judgment": {
                "enum": [
                  null,
                  "uncertain"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "measurement_mode": {
                "const": "paired_off"
              }
            }
          },
          "then": {
            "properties": {
              "baseline_request_identity": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "measurement_mode": {
                "const": "paired_off"
              },
              "status": {
                "const": "measured"
              }
            }
          },
          "then": {
            "properties": {
              "baseline_actual_reply_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "judgment": {
                "enum": [
                  "better",
                  "equivalent",
                  "worse"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "measurement_mode": {
                "const": "paired_off"
              },
              "status": {
                "const": "measured"
              },
              "judgment": {
                "const": "better"
              }
            }
          },
          "then": {
            "properties": {
              "score": {
                "enum": [
                  null,
                  1
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "measurement_mode": {
                "const": "paired_off"
              },
              "status": {
                "const": "measured"
              },
              "judgment": {
                "const": "equivalent"
              }
            }
          },
          "then": {
            "properties": {
              "score": {
                "enum": [
                  null,
                  0
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "measurement_mode": {
                "const": "paired_off"
              },
              "status": {
                "const": "measured"
              },
              "judgment": {
                "const": "worse"
              }
            }
          },
          "then": {
            "properties": {
              "score": {
                "enum": [
                  null,
                  -1
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "completed_uncertain"
              }
            }
          },
          "then": {
            "properties": {
              "actual_reply_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "judgment": {
                "const": "uncertain"
              },
              "score": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "completed_uncertain"
              },
              "measurement_mode": {
                "const": "paired_off"
              }
            }
          },
          "then": {
            "properties": {
              "baseline_actual_reply_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      ],
      "description": "Evaluation-only. paired_off judgments compare this terminal reply directly to the explicitly bound frozen OFF reply. Exact prefix, G and payload compatibility require separate cross-record validation. No evaluation record may be retrieved as a resource. completed_uncertain means assessment finished without a usable preference, not a pending job; semantic_review_round permits only the predeclared initial round and one review."
    }
  }
