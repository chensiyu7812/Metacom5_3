{
 "protocol": "semcap-g6-states-v1",
 "written": "2026-11-27 JST by Claude Code after reading each state, before any G6 prediction; no reference claims written (post-hoc only)",
 "failure_taxonomy": {
  "fact_or_stage": "asserts/presupposes an event, outcome or stage (planned vs done, considered vs decided) the records do not establish or contradict",
  "subject_or_time": "misattributes who did/said/experienced something (incl. the AI claiming a previous supporter's experience) or re-anchors an earlier relative time",
  "insufficient_information": "states as fact something nothing in the records supports (invention)",
  "important_omission": "misses a central, explicitly reported concern in the should items",
  "goal_or_support_need": "misreads what the user wants now (e.g. pushes advice the user declined)",
  "generator_usage": "mechanical errors: thinking leak, truncation, meta talk, ignoring the latest turn"
 },
 "gate": {
  "substantive_fixable_failure": "a fact_or_stage, subject_or_time or insufficient_information failure that (i) would mislead the user or misrepresent their situation, not a wording slip, and (ii) concerns something checkable against the legal records, so a correct INSPECT_CLAIM could in principle prevent it",
  "continue_if": "substantive fixable failures in >= 3 screening states from >= 3 distinct source families (distinct family_id; EvoEmo states count as distinct only with distinct owners)",
  "otherwise": "stop the online INSPECT_CLAIM line; hold-out not run",
  "not_counted": "important_omission, goal_or_support_need, generator_usage (recorded, reported)",
  "reviewer": "assistant development review during the run, written to GATE_REVIEW before the decision file"
 },
