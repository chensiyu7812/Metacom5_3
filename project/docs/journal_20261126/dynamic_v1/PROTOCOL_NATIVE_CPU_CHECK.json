    "parser_policy": "bare JSON; reject duplicate keys, nonfinite numbers, bool integers, extras",
    "protocol": "pmrl1-j-dynamic-controller-protocol-v1",
    "schemas": {
      "LLMOneShot": {
        "items": {
          "anyOf": [
            {
              "additionalProperties": false,
              "properties": {
                "action": {
                  "const": "STOP"
                }
              },
              "required": [
                "action"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "action": {
                  "const": "SEARCH"
                },
                "query": {
                  "minLength": 1,
                  "type": "string"
                }
              },
              "required": [
                "action",
                "query"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "action": {
                  "const": "EXPAND"
                },
                "from_search": {
                  "maximum": 3,
                  "minimum": 0,
                  "type": "integer"
                },
                "hit_rank": {
                  "enum": [
                    0,
                    1
                  ],
                  "type": "integer"
                }
              },
              "required": [
                "action",
                "from_search",
                "hit_rank"
              ],
              "type": "object"
            }
          ]
        },
        "maxItems": 5,
        "minItems": 1,
        "type": "array"
      },
      "LLMToolAgent": {
        "anyOf": [
          {
            "additionalProperties": false,
            "properties": {
              "action": {
                "const": "STOP"
              }
            },
            "required": [
              "action"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "action": {
                "const": "SEARCH"
              },
              "query": {
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "action",
              "query"
            ],
            "type": "object"
          },
          {
            "additionalProperties": false,
            "properties": {
              "action": {
                "const": "EXPAND"
              },
              "handle": {
                "pattern": "^hit:[0-9a-f]{24}$",
                "type": "string"
              }
            },
            "required": [
              "action",
              "handle"
            ],
            "type": "object"
          }
        ]
      }
    },
    "source_semantics": "existing pomdp_memory.query_tokens and observation-only provenance",
