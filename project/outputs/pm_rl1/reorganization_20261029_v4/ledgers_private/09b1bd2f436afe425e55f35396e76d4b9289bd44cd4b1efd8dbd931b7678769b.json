    "p9/esc82:10": {
      "owner_id": "p9",
      "session_id": "esc82",
      "session_rank": 0,
      "turn_index": 10,
      "speaker": "supporter",
      "text": "I am really sorry that has got to be the worst feeling putting your dog to sleep",
