    "p9/esc82:11": {
      "owner_id": "p9",
      "session_id": "esc82",
      "session_rank": 0,
      "turn_index": 11,
      "speaker": "seeker",
      "text": "It is. At least I was able to be with her so she wasn't afraid.",
      "reported_at": "2024-06-14",
      "identity": "55817f253e39372e5a84cb8e5b94c7bc00320c4901481f9c14dd734acfc5fe8f"
    },
    "p9/esc82:12": {
      "owner_id": "p9",
      "session_id": "esc82",
      "session_rank": 0,
      "turn_index": 12,
      "speaker": "supporter",
      "text": "I just think of it this way your dog is in dog heaven and is watching over you that is how i think of it even though it really aint true thats just how i think",
      "reported_at": "2024-06-14",
      "identity": "85d5255ac696104c0c2f63a95fb86a2b7b5c27a9a69c34620fcad009b788db4b"
    },
    "p9/esc82:13": {
      "owner_id": "p9",
      "session_id": "esc82",
      "session_rank": 0,
      "turn_index": 13,
      "speaker": "supporter",
      "text": "My dog died of old age ",
      "reported_at": "2024-06-14",
      "identity": "c0a77a1a7791390aced470078b3f144148ebcb3c232febccd772ccfba0456217"
    },
    "p9/esc82:14": {
      "owner_id": "p9",
      "session_id": "esc82",
      "session_rank": 0,
      "turn_index": 14,
      "speaker": "supporter",
      "text": "it took me like 2 or 3 weeks to get over it and not cry for once ",
      "reported_at": "2024-06-14",
      "identity": "b46b7e37b14a9f31a4b351f3036e588567d6feee3d35b30754da7106d436ee11"
    },
    "p9/esc82:15": {
      "owner_id": "p9",
      "session_id": "esc82",
      "session_rank": 0,
      "turn_index": 15,
      "speaker": "seeker",
      "text": "I just miss her. I believe she is with her brother. He died 7 years ago. He was hit by a car.",
      "reported_at": "2024-06-14",
      "identity": "bc1339591a4a338651def1fc6aa083ecc2fef9adcffb4a4e2f17f6578bfeb7c2"
    },
    "p9/esc82:16": {
      "owner_id": "p9",
      "session_id": "esc82",
      "session_rank": 0,
      "turn_index": 16,
      "speaker": "seeker",
      "text": "I can understand that",
      "reported_at": "2024-06-14",
      "identity": "3ebd6108d87a19a815bd96e0f013fd2a00d4bf60e19d8be4e919f907cf21e30c"
    },
    "p9/esc82:17": {
      "owner_id": "p9",
      "session_id": "esc82",
      "session_rank": 0,
      "turn_index": 17,
      "speaker": "supporter",
      "text": "I can understand how you feeling but everything will be okay and it is ok to miss her ",
      "reported_at": "2024-06-14",
      "identity": "24cb18646869f3e303ccb078e4f1c29e4b4aac70265f461d02da24f08463d550"
    },
    "p9/esc82:18": {
      "owner_id": "p9",
      "session_id": "esc82",
      "session_rank": 0,
      "turn_index": 18,
      "speaker": "seeker",
      "text": "I was doing pretty good then there was this dog in the movie and I just broke down again.",
      "reported_at": "2024-06-14",
      "identity": "6152f070ad0a313e34035e79f040d6b05ce20437586cfb5ea22fff4a1640c433"
    },
    "p9/esc82:19": {
      "owner_id": "p9",
      "session_id": "esc82",
      "session_rank": 0,
      "turn_index": 19,
      "speaker": "supporter",
      "text": "I understand I would break down to if I saw that ",
      "reported_at": "2024-06-14",
      "identity": "be8bbe74f09f469899ef497e82b1ea87ed4f20bfcf3a7bf3f436c7a738a6d41f"
    },
    "p9/esc82:2": {
      "owner_id": "p9",
      "session_id": "esc82",
      "session_rank": 0,
      "turn_index": 2,
      "speaker": "supporter",
      "text": "How may i help you today?",
