      "identity": "7d7e0b7e589001f15ee4a54b8b0f3317537d7dc18ed09ef0628335cc1d9c5310"
    },
    "p9/esc82:20": {
      "owner_id": "p9",
      "session_id": "esc82",
      "session_rank": 0,
      "turn_index": 20,
      "speaker": "supporter",
      "text": "Just do something you like to do to get your mind off of it ",
