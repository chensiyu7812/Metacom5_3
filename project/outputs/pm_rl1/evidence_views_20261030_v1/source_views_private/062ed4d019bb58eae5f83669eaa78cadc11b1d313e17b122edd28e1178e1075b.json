    {
      "head": "MS",
      "key": "ms::p3::esc207",
      "raw_transcript_identity": "c395ef5a2d479eecbf0937d8b74284956de069c6ddbaf7f111cdcf23510a871f",
      "resource_identity": "c905b31fd364736a9086eb28909d7dc86ac22138dd44970667dd0affa5252b50",
      "semantic_support": "unverified",
      "status": "located",
      "turns": [
        {
          "owner_id": "p3",
          "reported_at": "2024-12-20",
          "session_id": "esc207",
          "session_rank": 0,
          "speaker": "supporter",
          "text": "How are you today?",
          "turn_index": 0
        },
        {
          "owner_id": "p3",
          "reported_at": "2024-12-20",
          "session_id": "esc207",
          "session_rank": 0,
          "speaker": "seeker",
          "text": "I'm doing pretty good.",
          "turn_index": 1
        },
        {
          "owner_id": "p3",
          "reported_at": "2024-12-20",
          "session_id": "esc207",
          "session_rank": 0,
          "speaker": "supporter",
          "text": "I'm glad to hear you're doing well in these trying times.",
          "turn_index": 2
        },
        {
          "owner_id": "p3",
          "reported_at": "2024-12-20",
          "session_id": "esc207",
          "session_rank": 0,
          "speaker": "seeker",
          "text": "Yah they are very difficult.",
          "turn_index": 3
        },
        {
          "owner_id": "p3",
          "reported_at": "2024-12-20",
          "session_id": "esc207",
          "session_rank": 0,
          "speaker": "supporter",
          "text": "How have you been managing everything?",
          "turn_index": 4
        },
        {
          "owner_id": "p3",
          "reported_at": "2024-12-20",
          "session_id": "esc207",
          "session_rank": 0,
          "speaker": "seeker",
          "text": "Fine I've been pretty much just trying to go out as little as possible and stay safe.",
          "turn_index": 5
        },
        {
          "owner_id": "p3",
          "reported_at": "2024-12-20",
          "session_id": "esc207",
          "session_rank": 0,
          "speaker": "supporter",
          "text": "Same here, it's a tough time to do that after doing it so long. Especially with the holidays coming up.",
          "turn_index": 6
        },
        {
          "owner_id": "p3",
          "reported_at": "2024-12-20",
          "session_id": "esc207",
          "session_rank": 0,
          "speaker": "seeker",
          "text": "Yes I would have to agree.",
          "turn_index": 7
        },
        {
          "owner_id": "p3",
          "reported_at": "2024-12-20",
          "session_id": "esc207",
          "session_rank": 0,
          "speaker": "supporter",
          "text": "Are you in close proximity to your family?",
          "turn_index": 8
        },
        {
          "owner_id": "p3",
          "reported_at": "2024-12-20",
          "session_id": "esc207",
          "session_rank": 0,
          "speaker": "seeker",
          "text": "Yeah I'm staying with them for the holidays and then going back home in January.",
          "turn_index": 9
        },
        {
          "owner_id": "p3",
          "reported_at": "2024-12-20",
          "session_id": "esc207",
          "session_rank": 0,
          "speaker": "supporter",
          "text": "I imagine that can create some stress?",
          "turn_index": 10
        },
        {
          "owner_id": "p3",
          "reported_at": "2024-12-20",
          "session_id": "esc207",
          "session_rank": 0,
          "speaker": "seeker",
          "text": "No not really it's all good over here.",
          "turn_index": 11
        },
        {
          "owner_id": "p3",
          "reported_at": "2024-12-20",
          "session_id": "esc207",
          "session_rank": 0,
          "speaker": "supporter",
          "text": "Well I'm glad to hear it, sounds like you've been managing pretty well then.  ",
          "turn_index": 12
        },
        {
          "owner_id": "p3",
          "reported_at": "2024-12-20",
          "session_id": "esc207",
          "session_rank": 0,
          "speaker": "seeker",
          "text": "Yes because I am on winter break now.",
          "turn_index": 13
        },
        {
          "owner_id": "p3",
          "reported_at": "2024-12-20",
          "session_id": "esc207",
          "session_rank": 0,
          "speaker": "supporter",
          "text": "I assume that means you're in college then? So the stress of finals is over now?",
          "turn_index": 14
        },
        {
          "owner_id": "p3",
          "reported_at": "2024-12-20",
          "session_id": "esc207",
          "session_rank": 0,
          "speaker": "seeker",
          "text": "Yes I am. And yeah I just finished finals.",
          "turn_index": 15
        },
        {
          "owner_id": "p3",
          "reported_at": "2024-12-20",
          "session_id": "esc207",
          "session_rank": 0,
          "speaker": "supporter",
          "text": "That's good, I hope they went well for you.",
          "turn_index": 16
        },
        {
          "owner_id": "p3",
          "reported_at": "2024-12-20",
          "session_id": "esc207",
          "session_rank": 0,
          "speaker": "seeker",
          "text": "They did. Some were hard, but at least they're over now.",
          "turn_index": 17
        },
        {
          "owner_id": "p3",
          "reported_at": "2024-12-20",
          "session_id": "esc207",
          "session_rank": 0,
          "speaker": "supporter",
          "text": "Yes, now you can relax and spend time with your family without the added stress.",
          "turn_index": 18
        },
        {
          "owner_id": "p3",
          "reported_at": "2024-12-20",
          "session_id": "esc207",
          "session_rank": 0,
          "speaker": "seeker",
          "text": "Yes, exactly.",
          "turn_index": 19
        },
        {
          "owner_id": "p3",
          "reported_at": "2024-12-20",
          "session_id": "esc207",
          "session_rank": 0,
          "speaker": "supporter",
          "text": "Well I hope you and your family enjoy the holidays and stay safe.",
          "turn_index": 20
        },
        {
          "owner_id": "p3",
          "reported_at": "2024-12-20",
          "session_id": "esc207",
          "session_rank": 0,
          "speaker": "seeker",
          "text": "Thank you, you too. ",
          "turn_index": 21
        },
        {
          "owner_id": "p3",
          "reported_at": "2024-12-20",
          "session_id": "esc207",
          "session_rank": 0,
          "speaker": "supporter",
          "text": "Thanks so much!",
          "turn_index": 22
        },
        {
          "owner_id": "p3",
          "reported_at": "2024-12-20",
          "session_id": "esc207",
          "session_rank": 0,
          "speaker": "seeker",
          "text": "Are you with family?",
          "turn_index": 23
        },
        {
          "owner_id": "p3",
          "reported_at": "2024-12-20",
          "session_id": "esc207",
          "session_rank": 0,
          "speaker": "supporter",
          "text": "Yes, just my immediate family.",
          "turn_index": 24
        },
        {
          "owner_id": "p3",
          "reported_at": "2024-12-20",
          "session_id": "esc207",
          "session_rank": 0,
          "speaker": "seeker",
          "text": "Oh that's good. Staying safe.",
          "turn_index": 25
        },
        {
          "owner_id": "p3",
          "reported_at": "2024-12-20",
          "session_id": "esc207",
          "session_rank": 0,
          "speaker": "supporter",
          "text": "Absolutely, the best thing we can do right now. Even though it's kind of a bummer.",
          "turn_index": 26
        },
        {
          "owner_id": "p3",
          "reported_at": "2024-12-20",
          "session_id": "esc207",
          "session_rank": 0,
          "speaker": "seeker",
          "text": "Yeah, hopefully things will go back to normal soon. ",
          "turn_index": 27
        },
        {
          "owner_id": "p3",
          "reported_at": "2024-12-20",
          "session_id": "esc207",
          "session_rank": 0,
          "speaker": "supporter",
          "text": "I hope so too, this has been such a crazy year.",
          "turn_index": 28
        },
        {
          "owner_id": "p3",
          "reported_at": "2024-12-20",
          "session_id": "esc207",
          "session_rank": 0,
          "speaker": "seeker",
          "text": "I agree.",
          "turn_index": 29
        }
      ]
    },
