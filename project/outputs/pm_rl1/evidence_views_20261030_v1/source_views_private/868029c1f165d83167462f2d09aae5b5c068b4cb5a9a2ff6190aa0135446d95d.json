      "raw_transcript_identity": "ad3717eebb0ecf963eccd7e23adeb9e10a0a1b2905c79ee9647c0d286bb35839",
      "resource_identity": "77e26263bc54eed2b01ee1e3d2973ee420108a05dfb6764dca528ac7d1ef2edd",
      "semantic_support": "unverified",
      "status": "located",
      "turns": [
        {
          "owner_id": "p13",
          "reported_at": "2024-07-01",
          "session_id": "esc585",
          "session_rank": 0,
          "speaker": "supporter",
          "text": "HI there, how are you doing?",
          "turn_index": 0
        },
        {
          "owner_id": "p13",
          "reported_at": "2024-07-01",
          "session_id": "esc585",
          "session_rank": 0,
          "speaker": "seeker",
          "text": "Hi, I'm ok",
          "turn_index": 1
        },
        {
          "owner_id": "p13",
          "reported_at": "2024-07-01",
          "session_id": "esc585",
          "session_rank": 0,
          "speaker": "supporter",
          "text": "Do you want to talk about whats going on right now?",
          "turn_index": 2
        },
        {
          "owner_id": "p13",
          "reported_at": "2024-07-01",
          "session_id": "esc585",
          "session_rank": 0,
          "speaker": "seeker",
          "text": "Sure. I took a nude photo of myself to share with someone I'm dating, and accidentally sent it to several friends in a group chat",
          "turn_index": 3
        },
        {
          "owner_id": "p13",
          "reported_at": "2024-07-01",
          "session_id": "esc585",
          "session_rank": 0,
          "speaker": "seeker",
          "text": "I'm really embarrassed about it and I have some anxiety about meeting or talking to my friends",
          "turn_index": 4
        },
        {
          "owner_id": "p13",
          "reported_at": "2024-07-01",
          "session_id": "esc585",
          "session_rank": 0,
          "speaker": "supporter",
          "text": "Ive done some things like that before. I know this might sound weird but what helped me through it was to actually own it. Take control of it before they can.",
          "turn_index": 5
        },
        {
          "owner_id": "p13",
          "reported_at": "2024-07-01",
          "session_id": "esc585",
          "session_rank": 0,
          "speaker": "seeker",
          "text": "Do you think it would be helpful to use humor? I don't want them to tease me about it but I don't know how else to approach it",
          "turn_index": 6
        },
        {
          "owner_id": "p13",
          "reported_at": "2024-07-01",
          "session_id": "esc585",
          "session_rank": 0,
          "speaker": "supporter",
          "text": "Yea that is definitely one way to control it",
          "turn_index": 7
        },
        {
          "owner_id": "p13",
          "reported_at": "2024-07-01",
          "session_id": "esc585",
          "session_rank": 0,
          "speaker": "seeker",
          "text": "Lol maybe some of my friends will share with the group too",
          "turn_index": 8
        },
        {
          "owner_id": "p13",
          "reported_at": "2024-07-01",
          "session_id": "esc585",
          "session_rank": 0,
          "speaker": "seeker",
          "text": "that would definitely make me feel better about it",
          "turn_index": 9
        },
        {
          "owner_id": "p13",
          "reported_at": "2024-07-01",
          "session_id": "esc585",
          "session_rank": 0,
          "speaker": "supporter",
          "text": "Ha, well that could get interesting",
          "turn_index": 10
        },
        {
          "owner_id": "p13",
          "reported_at": "2024-07-01",
          "session_id": "esc585",
          "session_rank": 0,
          "speaker": "seeker",
          "text": "yes, for sure",
          "turn_index": 11
        },
        {
          "owner_id": "p13",
          "reported_at": "2024-07-01",
          "session_id": "esc585",
          "session_rank": 0,
          "speaker": "seeker",
          "text": "anyway, thanks for the chat. this was helpful",
          "turn_index": 12
        }
      ]
    },
