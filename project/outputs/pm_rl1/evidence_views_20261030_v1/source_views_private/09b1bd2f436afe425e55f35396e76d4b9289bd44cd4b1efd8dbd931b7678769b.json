  "bindings": [
    {
      "head": "MS",
      "key": "ms::p9::esc82",
      "raw_transcript_identity": "b85cf6ba12963e04b1b67c5effff54f289e22f3630d95714b4ebc73395a068aa",
      "resource_identity": "bfd2cec6d563cb5b93d66c5befda04cd533dc31c5a6acf1e37a64c9d30045b08",
      "semantic_support": "unverified",
      "status": "located",
      "turns": [
        {
          "owner_id": "p9",
          "reported_at": "2024-06-14",
          "session_id": "esc82",
          "session_rank": 0,
          "speaker": "supporter",
          "text": "Hello",
          "turn_index": 0
        },
        {
          "owner_id": "p9",
          "reported_at": "2024-06-14",
          "session_id": "esc82",
          "session_rank": 0,
          "speaker": "seeker",
          "text": "hello",
          "turn_index": 1
        },
        {
          "owner_id": "p9",
          "reported_at": "2024-06-14",
          "session_id": "esc82",
          "session_rank": 0,
          "speaker": "supporter",
          "text": "How may i help you today?",
          "turn_index": 2
        },
        {
          "owner_id": "p9",
          "reported_at": "2024-06-14",
          "session_id": "esc82",
          "session_rank": 0,
          "speaker": "seeker",
          "text": "I've been sad. My dog died",
          "turn_index": 3
        },
        {
          "owner_id": "p9",
          "reported_at": "2024-06-14",
          "session_id": "esc82",
          "session_rank": 0,
          "speaker": "supporter",
          "text": "I am sorry I know exactly how you are feeling I have had a dog that i loved more than anything die couple years ago",
          "turn_index": 4
        },
        {
          "owner_id": "p9",
          "reported_at": "2024-06-14",
          "session_id": "esc82",
          "session_rank": 0,
          "speaker": "seeker",
          "text": "Sorry to hear that. I just watched a movie that had a dog that looked like mine in it. It upset me",
          "turn_index": 5
        },
        {
          "owner_id": "p9",
          "reported_at": "2024-06-14",
          "session_id": "esc82",
          "session_rank": 0,
          "speaker": "supporter",
          "text": "What movie was it?",
          "turn_index": 6
        },
        {
          "owner_id": "p9",
          "reported_at": "2024-06-14",
          "session_id": "esc82",
          "session_rank": 0,
          "speaker": "seeker",
          "text": "I don't remember the name of the movie, but it was about some kids trying to find homes for dogs that a shelter was closing before Christmas",
          "turn_index": 7
        },
        {
          "owner_id": "p9",
          "reported_at": "2024-06-14",
          "session_id": "esc82",
          "session_rank": 0,
          "speaker": "supporter",
          "text": "Oh ok how did your dog die was something wrong with him or just old age?",
          "turn_index": 8
        },
        {
          "owner_id": "p9",
          "reported_at": "2024-06-14",
          "session_id": "esc82",
          "session_rank": 0,
          "speaker": "seeker",
          "text": "She was old, blind and was getting dog dementia. I had to have her put to sleep",
          "turn_index": 9
        },
        {
          "owner_id": "p9",
          "reported_at": "2024-06-14",
          "session_id": "esc82",
          "session_rank": 0,
          "speaker": "supporter",
          "text": "I am really sorry that has got to be the worst feeling putting your dog to sleep",
          "turn_index": 10
        },
        {
          "owner_id": "p9",
          "reported_at": "2024-06-14",
          "session_id": "esc82",
          "session_rank": 0,
          "speaker": "seeker",
          "text": "It is. At least I was able to be with her so she wasn't afraid.",
          "turn_index": 11
        },
        {
          "owner_id": "p9",
          "reported_at": "2024-06-14",
          "session_id": "esc82",
          "session_rank": 0,
          "speaker": "supporter",
          "text": "I just think of it this way your dog is in dog heaven and is watching over you that is how i think of it even though it really aint true thats just how i think",
          "turn_index": 12
        },
        {
          "owner_id": "p9",
          "reported_at": "2024-06-14",
          "session_id": "esc82",
          "session_rank": 0,
          "speaker": "supporter",
          "text": "My dog died of old age ",
          "turn_index": 13
        },
        {
          "owner_id": "p9",
          "reported_at": "2024-06-14",
          "session_id": "esc82",
          "session_rank": 0,
          "speaker": "supporter",
          "text": "it took me like 2 or 3 weeks to get over it and not cry for once ",
          "turn_index": 14
        },
        {
          "owner_id": "p9",
          "reported_at": "2024-06-14",
          "session_id": "esc82",
          "session_rank": 0,
          "speaker": "seeker",
          "text": "I just miss her. I believe she is with her brother. He died 7 years ago. He was hit by a car.",
          "turn_index": 15
        },
        {
          "owner_id": "p9",
          "reported_at": "2024-06-14",
          "session_id": "esc82",
          "session_rank": 0,
          "speaker": "seeker",
          "text": "I can understand that",
          "turn_index": 16
        },
        {
          "owner_id": "p9",
          "reported_at": "2024-06-14",
          "session_id": "esc82",
          "session_rank": 0,
          "speaker": "supporter",
          "text": "I can understand how you feeling but everything will be okay and it is ok to miss her ",
          "turn_index": 17
        },
        {
          "owner_id": "p9",
          "reported_at": "2024-06-14",
          "session_id": "esc82",
          "session_rank": 0,
          "speaker": "seeker",
          "text": "I was doing pretty good then there was this dog in the movie and I just broke down again.",
          "turn_index": 18
        },
        {
          "owner_id": "p9",
          "reported_at": "2024-06-14",
          "session_id": "esc82",
          "session_rank": 0,
          "speaker": "supporter",
          "text": "I understand I would break down to if I saw that ",
          "turn_index": 19
        },
        {
          "owner_id": "p9",
          "reported_at": "2024-06-14",
          "session_id": "esc82",
          "session_rank": 0,
          "speaker": "supporter",
          "text": "Just do something you like to do to get your mind off of it ",
          "turn_index": 20
        },
        {
          "owner_id": "p9",
          "reported_at": "2024-06-14",
          "session_id": "esc82",
          "session_rank": 0,
          "speaker": "seeker",
          "text": "It helps to have a person to talk to. I used this chat Hit before right after I had to put her to sleep. The person I talked to then had a dog too.",
          "turn_index": 21
        },
        {
          "owner_id": "p9",
          "reported_at": "2024-06-14",
          "session_id": "esc82",
          "session_rank": 0,
          "speaker": "supporter",
          "text": "Right it is always good to have someone to talk to in a situation like that ",
          "turn_index": 22
        },
        {
          "owner_id": "p9",
          "reported_at": "2024-06-14",
          "session_id": "esc82",
          "session_rank": 0,
          "speaker": "seeker",
          "text": "It's a good Idea to do something to get my mind off of it.",
          "turn_index": 23
        },
        {
          "owner_id": "p9",
          "reported_at": "2024-06-14",
          "session_id": "esc82",
          "session_rank": 0,
          "speaker": "supporter",
          "text": "Just by expressing your feelings with someone will help a lot to",
          "turn_index": 24
        },
        {
          "owner_id": "p9",
          "reported_at": "2024-06-14",
          "session_id": "esc82",
          "session_rank": 0,
          "speaker": "seeker",
          "text": "Yes it helps.",
          "turn_index": 25
        },
        {
          "owner_id": "p9",
          "reported_at": "2024-06-14",
          "session_id": "esc82",
          "session_rank": 0,
          "speaker": "supporter",
          "text": "Maybe you can watch a comedy movie or another kind of movie to get your mind off of it",
          "turn_index": 26
        },
        {
          "owner_id": "p9",
          "reported_at": "2024-06-14",
          "session_id": "esc82",
          "session_rank": 0,
          "speaker": "seeker",
          "text": "That sounds like a good idea. A comedy probably would help",
          "turn_index": 27
        },
        {
          "owner_id": "p9",
          "reported_at": "2024-06-14",
          "session_id": "esc82",
          "session_rank": 0,
          "speaker": "supporter",
          "text": "yes it would help. Keep your head up and know your dog is dog heaven and not suffering anymore.",
          "turn_index": 28
        },
        {
          "owner_id": "p9",
          "reported_at": "2024-06-14",
          "session_id": "esc82",
          "session_rank": 0,
          "speaker": "seeker",
          "text": "Okay. Thanks for talking. Goodnight.",
          "turn_index": 29
        },
        {
          "owner_id": "p9",
          "reported_at": "2024-06-14",
          "session_id": "esc82",
          "session_rank": 0,
          "speaker": "supporter",
          "text": "your welcome goodnight",
          "turn_index": 30
        }
      ]
    },
