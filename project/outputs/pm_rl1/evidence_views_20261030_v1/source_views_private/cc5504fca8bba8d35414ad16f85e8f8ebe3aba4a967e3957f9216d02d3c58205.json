    {
      "head": "MS",
      "key": "ms::p12::esc1212",
      "raw_transcript_identity": "028c1cdaaa069c96dae45991e707926f340cb4447c1c37c5666d219a421fc134",
      "resource_identity": "e59fdd63c9f5c1e06f6860e343de3fa32bbbb1aafcc1fef285a20c3115d7c345",
      "semantic_support": "unverified",
      "status": "located",
      "turns": [
        {
          "owner_id": "p12",
          "reported_at": "2024-06-15",
          "session_id": "esc1212",
          "session_rank": 1,
          "speaker": "seeker",
          "text": "hello",
          "turn_index": 0
        },
        {
          "owner_id": "p12",
          "reported_at": "2024-06-15",
          "session_id": "esc1212",
          "session_rank": 1,
          "speaker": "supporter",
          "text": "hello",
          "turn_index": 1
        },
        {
          "owner_id": "p12",
          "reported_at": "2024-06-15",
          "session_id": "esc1212",
          "session_rank": 1,
          "speaker": "seeker",
          "text": "i need som help, i feel so sad.",
          "turn_index": 2
        },
        {
          "owner_id": "p12",
          "reported_at": "2024-06-15",
          "session_id": "esc1212",
          "session_rank": 1,
          "speaker": "supporter",
          "text": "I am sorry to hear that. Is there anything I can do for you? Please tell me what's wrong?",
          "turn_index": 3
        },
        {
          "owner_id": "p12",
          "reported_at": "2024-06-15",
          "session_id": "esc1212",
          "session_rank": 1,
          "speaker": "seeker",
          "text": "I think you can talk to me, maybe I will feel a bit better.",
          "turn_index": 4
        },
        {
          "owner_id": "p12",
          "reported_at": "2024-06-15",
          "session_id": "esc1212",
          "session_rank": 1,
          "speaker": "seeker",
          "text": "I had a breakup with my boyfriend. ",
          "turn_index": 5
        },
        {
          "owner_id": "p12",
          "reported_at": "2024-06-15",
          "session_id": "esc1212",
          "session_rank": 1,
          "speaker": "seeker",
          "text": "Feeling depressed, can you give me any advice?",
          "turn_index": 6
        },
        {
          "owner_id": "p12",
          "reported_at": "2024-06-15",
          "session_id": "esc1212",
          "session_rank": 1,
          "speaker": "supporter",
          "text": "For sure, I am happy to talk to you. I am sorry for your breakup. ",
          "turn_index": 7
        },
        {
          "owner_id": "p12",
          "reported_at": "2024-06-15",
          "session_id": "esc1212",
          "session_rank": 1,
          "speaker": "seeker",
          "text": "Thank you, but  I do not feel motivated to do anything. What should i do with my feelings?",
          "turn_index": 8
        },
        {
          "owner_id": "p12",
          "reported_at": "2024-06-15",
          "session_id": "esc1212",
          "session_rank": 1,
          "speaker": "supporter",
          "text": "Is there anything you want to do right now that helps maybe. For example, to eat something, to listen good music or take small walk in fresh air etc",
          "turn_index": 9
        },
        {
          "owner_id": "p12",
          "reported_at": "2024-06-15",
          "session_id": "esc1212",
          "session_rank": 1,
          "speaker": "supporter",
          "text": "I can feel you, it must be so hard to you. take your time do not think about a lot",
          "turn_index": 10
        },
        {
          "owner_id": "p12",
          "reported_at": "2024-06-15",
          "session_id": "esc1212",
          "session_rank": 1,
          "speaker": "supporter",
          "text": "when I have bad times, I just want to take a nap. It maybe help you feel better",
          "turn_index": 11
        },
        {
          "owner_id": "p12",
          "reported_at": "2024-06-15",
          "session_id": "esc1212",
          "session_rank": 1,
          "speaker": "seeker",
          "text": "I think you are right, maybe i just need to take a pause in my life for now, yeah I like to sleep. Thanks for supporting me. ",
          "turn_index": 12
        },
        {
          "owner_id": "p12",
          "reported_at": "2024-06-15",
          "session_id": "esc1212",
          "session_rank": 1,
          "speaker": "seeker",
          "text": "I think I will try what you said today",
          "turn_index": 13
        },
        {
          "owner_id": "p12",
          "reported_at": "2024-06-15",
          "session_id": "esc1212",
          "session_rank": 1,
          "speaker": "seeker",
          "text": "Maybe I will watch some movies and then take a nap",
          "turn_index": 14
        },
        {
          "owner_id": "p12",
          "reported_at": "2024-06-15",
          "session_id": "esc1212",
          "session_rank": 1,
          "speaker": "supporter",
          "text": "I am happy to hear that. I hope you will feel better soon. ",
          "turn_index": 15
        },
        {
          "owner_id": "p12",
          "reported_at": "2024-06-15",
          "session_id": "esc1212",
          "session_rank": 1,
          "speaker": "seeker",
          "text": "Thank you for your support, I really appreciate it",
          "turn_index": 16
        },
        {
          "owner_id": "p12",
          "reported_at": "2024-06-15",
          "session_id": "esc1212",
          "session_rank": 1,
          "speaker": "supporter",
          "text": "You are welcome, I am here for you. ",
          "turn_index": 17
        }
      ]
    },
    {
      "head": "MS",
      "key": "ms::p12::esc894",
      "raw_transcript_identity": "6a0fca983922210142f24acc62a4ff6b992a05b21395355a83733df4c968c7e1",
      "resource_identity": "57b62283223f82b774a38c2952806330fb7d8664426b0a70fcabbcb8163c00de",
      "semantic_support": "unverified",
      "status": "located",
      "turns": [
        {
          "owner_id": "p12",
          "reported_at": "2024-06-10",
          "session_id": "esc894",
          "session_rank": 0,
          "speaker": "supporter",
          "text": "Hello, what can I help you?",
          "turn_index": 0
        },
        {
          "owner_id": "p12",
          "reported_at": "2024-06-10",
          "session_id": "esc894",
          "session_rank": 0,
          "speaker": "seeker",
          "text": "I really sad as my partner walked out on me. Any thoughts what could  cheer me up?",
          "turn_index": 1
        },
        {
          "owner_id": "p12",
          "reported_at": "2024-06-10",
          "session_id": "esc894",
          "session_rank": 0,
          "speaker": "supporter",
          "text": "Was there anything that leads to this?",
          "turn_index": 2
        },
        {
          "owner_id": "p12",
          "reported_at": "2024-06-10",
          "session_id": "esc894",
          "session_rank": 0,
          "speaker": "seeker",
          "text": "Not really. I thought everything was ok between us. That is why it kind of struck me.",
          "turn_index": 3
        },
        {
          "owner_id": "p12",
          "reported_at": "2024-06-10",
          "session_id": "esc894",
          "session_rank": 0,
          "speaker": "supporter",
          "text": "That's terrible and unacceptable behavior.",
          "turn_index": 4
        },
        {
          "owner_id": "p12",
          "reported_at": "2024-06-10",
          "session_id": "esc894",
          "session_rank": 0,
          "speaker": "supporter",
          "text": "How long have you been together?",
          "turn_index": 5
        },
        {
          "owner_id": "p12",
          "reported_at": "2024-06-10",
          "session_id": "esc894",
          "session_rank": 0,
          "speaker": "seeker",
          "text": "I have to agree with you-it is unacceptable, considering that he didn't give me any reasons as to why he did it. We have been together for 5 years. ",
          "turn_index": 6
        },
        {
          "owner_id": "p12",
          "reported_at": "2024-06-10",
          "session_id": "esc894",
          "session_rank": 0,
          "speaker": "supporter",
          "text": "That sucks. I wouldn't be able to accept either. ",
          "turn_index": 7
        },
        {
          "owner_id": "p12",
          "reported_at": "2024-06-10",
          "session_id": "esc894",
          "session_rank": 0,
          "speaker": "supporter",
          "text": "Have you talked to your friends about this?",
          "turn_index": 8
        },
        {
          "owner_id": "p12",
          "reported_at": "2024-06-10",
          "session_id": "esc894",
          "session_rank": 0,
          "speaker": "seeker",
          "text": "It is still rather raw,I have mentioned to it to a few of my friends and they deeply symphatise with me but I feel there is nothing much they can do to help me.They are as shocked as me to be honest.",
          "turn_index": 9
        },
        {
          "owner_id": "p12",
          "reported_at": "2024-06-10",
          "session_id": "esc894",
          "session_rank": 0,
          "speaker": "supporter",
          "text": "It is understandable to have that reaction. I agree with you, only us can hep ourselves.",
          "turn_index": 10
        },
        {
          "owner_id": "p12",
          "reported_at": "2024-06-10",
          "session_id": "esc894",
          "session_rank": 0,
          "speaker": "supporter",
          "text": "Have you tried doing activities that help distract you from having negative thoughts?",
          "turn_index": 11
        },
        {
          "owner_id": "p12",
          "reported_at": "2024-06-10",
          "session_id": "esc894",
          "session_rank": 0,
          "speaker": "seeker",
          "text": "Kind of, most of it involves eating loads of ice cream LOL. ",
          "turn_index": 12
        },
        {
          "owner_id": "p12",
          "reported_at": "2024-06-10",
          "session_id": "esc894",
          "session_rank": 0,
          "speaker": "supporter",
          "text": "Haha I feel you, I tend to eat a lot when depressed too. Look, it's treat yourself method. You deserve the best",
          "turn_index": 13
        },
        {
          "owner_id": "p12",
          "reported_at": "2024-06-10",
          "session_id": "esc894",
          "session_rank": 0,
          "speaker": "supporter",
          "text": "If you can go to the mountain or big lake, I would say try spending a few hours there. Maybe have a mini picnic by yourself and enjoy the nature.",
          "turn_index": 14
        },
        {
          "owner_id": "p12",
          "reported_at": "2024-06-10",
          "session_id": "esc894",
          "session_rank": 0,
          "speaker": "seeker",
          "text": "That is a brilliant idea,I do love walking and being outdoors. :) ",
          "turn_index": 15
        },
        {
          "owner_id": "p12",
          "reported_at": "2024-06-10",
          "session_id": "esc894",
          "session_rank": 0,
          "speaker": "seeker",
          "text": "It surely would help me to clear my mind",
          "turn_index": 16
        },
        {
          "owner_id": "p12",
          "reported_at": "2024-06-10",
          "session_id": "esc894",
          "session_rank": 0,
          "speaker": "supporter",
          "text": "Is there anything you have wanted to do but don't have the time? I always want to learn guitar and baking. This is the best time to start that",
          "turn_index": 17
        },
        {
          "owner_id": "p12",
          "reported_at": "2024-06-10",
          "session_id": "esc894",
          "session_rank": 0,
          "speaker": "seeker",
          "text": "oh yeah, I suppose I have more time now to focus on things I have always wanted to do but never kind of had time for it. I bought a high end photo camera ages ago but never really had a chance to use it properly-I guess it is time to pursue my interest in photography, and spending more time outdoors would be ideal for that!",
          "turn_index": 18
        },
        {
          "owner_id": "p12",
          "reported_at": "2024-06-10",
          "session_id": "esc894",
          "session_rank": 0,
          "speaker": "seeker",
          "text": "And reading! The list of books I want to read is arm long!",
          "turn_index": 19
        },
        {
          "owner_id": "p12",
          "reported_at": "2024-06-10",
          "session_id": "esc894",
          "session_rank": 0,
          "speaker": "supporter",
          "text": "That's the spirit! I know being treated like that feels horrible. However, I bet you have mourned enough, at the end of the day, a person treats you like that has no respect and you shouldn't waste time on them.",
          "turn_index": 20
        },
        {
          "owner_id": "p12",
          "reported_at": "2024-06-10",
          "session_id": "esc894",
          "session_rank": 0,
          "speaker": "supporter",
          "text": "It's time to invest in yourself, once you become your better version, a better partner will come to you",
          "turn_index": 21
        },
        {
          "owner_id": "p12",
          "reported_at": "2024-06-10",
          "session_id": "esc894",
          "session_rank": 0,
          "speaker": "seeker",
          "text": "I really agree with you- I am worth more than that. It is time to move on, even when it is difficult. The sad side of it is that I probably will never know what I did wrong for things to end like that. Maybe I didn't do anything wrong. That is the question what will always stay with me and that actually is the hardest bit of it all. But... I am not going to delve into it.",
          "turn_index": 22
        },
        {
          "owner_id": "p12",
          "reported_at": "2024-06-10",
          "session_id": "esc894",
          "session_rank": 0,
          "speaker": "seeker",
          "text": "I feel like hitting a jackpot actually hahahaha. I will be walking off those calories I get from ice cream I have been scoffing lately.So I am having the best of both worlds ",
          "turn_index": 23
        },
        {
          "owner_id": "p12",
          "reported_at": "2024-06-10",
          "session_id": "esc894",
          "session_rank": 0,
          "speaker": "seeker",
          "text": "Who said you cannot have the cake and eat it all LOL",
          "turn_index": 24
        },
        {
          "owner_id": "p12",
          "reported_at": "2024-06-10",
          "session_id": "esc894",
          "session_rank": 0,
          "speaker": "supporter",
          "text": "Yes!Actually don't think you did wrong. Reflecting after a relationship is good but don't put all the blame on yourself.",
          "turn_index": 25
        },
        {
          "owner_id": "p12",
          "reported_at": "2024-06-10",
          "session_id": "esc894",
          "session_rank": 0,
          "speaker": "supporter",
          "text": "You have learned from this relationship too i believe, use that for your next one",
          "turn_index": 26
        },
        {
          "owner_id": "p12",
          "reported_at": "2024-06-10",
          "session_id": "esc894",
          "session_rank": 0,
          "speaker": "seeker",
          "text": "I do not intend to. I am usually the kind of person who does blame oneself but I have found it is not right.",
          "turn_index": 27
        }
      ]
    },
    {
      "head": "MS",
      "key": "ms::p12::esc989",
      "raw_transcript_identity": "b5028288597c5eb4ede01c4252fe1016d7520525e6fe879354d2cfa44f4c4b43",
      "resource_identity": "3e676fc093f797875a08e0c9cc6983ec2bc2e9f0def6f5eeb6c77b02cf7e62c3",
      "semantic_support": "unverified",
      "status": "located",
      "turns": [
        {
          "owner_id": "p12",
          "reported_at": "2024-07-25",
          "session_id": "esc989",
          "session_rank": 2,
          "speaker": "supporter",
          "text": "Hello! What seems to be the problem?",
          "turn_index": 0
        },
        {
          "owner_id": "p12",
          "reported_at": "2024-07-25",
          "session_id": "esc989",
          "session_rank": 2,
          "speaker": "seeker",
          "text": "am having sleep disorder problem",
          "turn_index": 1
        },
        {
          "owner_id": "p12",
          "reported_at": "2024-07-25",
          "session_id": "esc989",
          "session_rank": 2,
          "speaker": "seeker",
          "text": "will you able to help?",
          "turn_index": 2
        },
        {
          "owner_id": "p12",
          "reported_at": "2024-07-25",
          "session_id": "esc989",
          "session_rank": 2,
          "speaker": "seeker",
          "text": "Daily am not able to sleep on time",
          "turn_index": 3
        },
        {
          "owner_id": "p12",
          "reported_at": "2024-07-25",
          "session_id": "esc989",
          "session_rank": 2,
          "speaker": "supporter",
          "text": "I will try my best. I specialise in yoga and meditation.",
          "turn_index": 4
        },
        {
          "owner_id": "p12",
          "reported_at": "2024-07-25",
          "session_id": "esc989",
          "session_rank": 2,
          "speaker": "seeker",
          "text": "Great",
          "turn_index": 5
        },
        {
          "owner_id": "p12",
          "reported_at": "2024-07-25",
          "session_id": "esc989",
          "session_rank": 2,
          "speaker": "supporter",
          "text": "How long has this been happening for?",
          "turn_index": 6
        },
        {
          "owner_id": "p12",
          "reported_at": "2024-07-25",
          "session_id": "esc989",
          "session_rank": 2,
          "speaker": "seeker",
          "text": "past 2 weeks",
          "turn_index": 7
        },
        {
          "owner_id": "p12",
          "reported_at": "2024-07-25",
          "session_id": "esc989",
          "session_rank": 2,
          "speaker": "seeker",
          "text": "will you able to help with some video links",
          "turn_index": 8
        },
        {
          "owner_id": "p12",
          "reported_at": "2024-07-25",
          "session_id": "esc989",
          "session_rank": 2,
          "speaker": "seeker",
          "text": "which I can see and follow",
          "turn_index": 9
        },
        {
          "owner_id": "p12",
          "reported_at": "2024-07-25",
          "session_id": "esc989",
          "session_rank": 2,
          "speaker": "supporter",
          "text": "This may be an obvious question, but can you think of something that has changed in the last two weeks?",
          "turn_index": 10
        },
        {
          "owner_id": "p12",
          "reported_at": "2024-07-25",
          "session_id": "esc989",
          "session_rank": 2,
          "speaker": "supporter",
          "text": "Think about work related, personal life, changes in behaviour?",
          "turn_index": 11
        },
        {
          "owner_id": "p12",
          "reported_at": "2024-07-25",
          "session_id": "esc989",
          "session_rank": 2,
          "speaker": "seeker",
          "text": "yeah. may be work related",
          "turn_index": 12
        },
        {
          "owner_id": "p12",
          "reported_at": "2024-07-25",
          "session_id": "esc989",
          "session_rank": 2,
          "speaker": "seeker",
          "text": "I am spending more time on work",
          "turn_index": 13
        },
        {
          "owner_id": "p12",
          "reported_at": "2024-07-25",
          "session_id": "esc989",
          "session_rank": 2,
          "speaker": "seeker",
          "text": "I need to switch some activities other than work",
          "turn_index": 14
        },
        {
          "owner_id": "p12",
          "reported_at": "2024-07-25",
          "session_id": "esc989",
          "session_rank": 2,
          "speaker": "seeker",
          "text": "will you suggest to take off for few more days from work?",
          "turn_index": 15
        },
        {
          "owner_id": "p12",
          "reported_at": "2024-07-25",
          "session_id": "esc989",
          "session_rank": 2,
          "speaker": "seeker",
          "text": "will that work",
          "turn_index": 16
        },
        {
          "owner_id": "p12",
          "reported_at": "2024-07-25",
          "session_id": "esc989",
          "session_rank": 2,
          "speaker": "seeker",
          "text": "or any other better solution",
          "turn_index": 17
        },
        {
          "owner_id": "p12",
          "reported_at": "2024-07-25",
          "session_id": "esc989",
          "session_rank": 2,
          "speaker": "supporter",
          "text": "It might solve as a temporary solution, however, if whatever happened at work to cause this continues when you return from holidays, you will just have the same problem again.",
          "turn_index": 18
        },
        {
          "owner_id": "p12",
          "reported_at": "2024-07-25",
          "session_id": "esc989",
          "session_rank": 2,
          "speaker": "supporter",
          "text": "What exactly do you think is causing it? Additional work/responsibilities? New manager?",
          "turn_index": 19
        },
        {
          "owner_id": "p12",
          "reported_at": "2024-07-25",
          "session_id": "esc989",
          "session_rank": 2,
          "speaker": "seeker",
          "text": "additional work being assigned to me",
          "turn_index": 20
        },
        {
          "owner_id": "p12",
          "reported_at": "2024-07-25",
          "session_id": "esc989",
          "session_rank": 2,
          "speaker": "seeker",
          "text": "that causes more work stress",
          "turn_index": 21
        },
        {
          "owner_id": "p12",
          "reported_at": "2024-07-25",
          "session_id": "esc989",
          "session_rank": 2,
          "speaker": "seeker",
          "text": "most of them are new to me, so am spending more time to learn ",
          "turn_index": 22
        },
        {
          "owner_id": "p12",
          "reported_at": "2024-07-25",
          "session_id": "esc989",
          "session_rank": 2,
          "speaker": "supporter",
          "text": "Have you tried to speak to your manager about these additional responsibilities? Do you know if it is a short term problem or you will always have extra work being assigned?",
          "turn_index": 23
        },
        {
          "owner_id": "p12",
          "reported_at": "2024-07-25",
          "session_id": "esc989",
          "session_rank": 2,
          "speaker": "seeker",
          "text": "I am trying to speak. but she is not listening much",
          "turn_index": 24
        },
        {
          "owner_id": "p12",
          "reported_at": "2024-07-25",
          "session_id": "esc989",
          "session_rank": 2,
          "speaker": "seeker",
          "text": "let me try to tell my situation and get some better solution",
          "turn_index": 25
        },
        {
          "owner_id": "p12",
          "reported_at": "2024-07-25",
          "session_id": "esc989",
          "session_rank": 2,
          "speaker": "seeker",
          "text": "will you able to share some yoga & mediation links?",
          "turn_index": 26
        },
        {
          "owner_id": "p12",
          "reported_at": "2024-07-25",
          "session_id": "esc989",
          "session_rank": 2,
          "speaker": "seeker",
          "text": "to divert me from the extra additional work",
          "turn_index": 27
        },
        {
          "owner_id": "p12",
          "reported_at": "2024-07-25",
          "session_id": "esc989",
          "session_rank": 2,
          "speaker": "supporter",
          "text": "I don't think I can share links over here, however the activities you perform directly before you go to sleep have a direct impact on your sleeping.",
          "turn_index": 28
        },
        {
          "owner_id": "p12",
          "reported_at": "2024-07-25",
          "session_id": "esc989",
          "session_rank": 2,
          "speaker": "supporter",
          "text": "I would recommend trying to practice 30m-1h of yoga (you can find lodes of exercise videos on the internet to follow), followed by a mediation sound track for you to listen to in bed while you try to sleep.",
          "turn_index": 29
        },
        {
          "owner_id": "p12",
          "reported_at": "2024-07-25",
          "session_id": "esc989",
          "session_rank": 2,
          "speaker": "supporter",
          "text": "Keep your body and mind clear before you go to sleep has proven to allow for a better sleep.",
          "turn_index": 30
        },
        {
          "owner_id": "p12",
          "reported_at": "2024-07-25",
          "session_id": "esc989",
          "session_rank": 2,
          "speaker": "supporter",
          "text": "I used to have sleeping issues, and I started doing this 2 years ago, and I completely changed. I am an investment banker and still am, it is a very stressful environment however this has allowed me to work at the very top and remain in control of my body and mind.",
          "turn_index": 31
        },
        {
          "owner_id": "p12",
          "reported_at": "2024-07-25",
          "session_id": "esc989",
          "session_rank": 2,
          "speaker": "supporter",
          "text": "Please try this for 1 week, I know you can do it and I know it will help you long term.",
          "turn_index": 32
        },
        {
          "owner_id": "p12",
          "reported_at": "2024-07-25",
          "session_id": "esc989",
          "session_rank": 2,
          "speaker": "seeker",
          "text": "Sure. I can try whatever you suggested",
          "turn_index": 33
        },
        {
          "owner_id": "p12",
          "reported_at": "2024-07-25",
          "session_id": "esc989",
          "session_rank": 2,
          "speaker": "seeker",
          "text": "I am sure definitely I will get some changes",
          "turn_index": 34
        },
        {
          "owner_id": "p12",
          "reported_at": "2024-07-25",
          "session_id": "esc989",
          "session_rank": 2,
          "speaker": "seeker",
          "text": "I felt good after chatting with you",
          "turn_index": 35
        },
        {
          "owner_id": "p12",
          "reported_at": "2024-07-25",
          "session_id": "esc989",
          "session_rank": 2,
          "speaker": "supporter",
          "text": "Thanks so good, I have really enjoyed talking to you too.",
          "turn_index": 36
        },
        {
          "owner_id": "p12",
          "reported_at": "2024-07-25",
          "session_id": "esc989",
          "session_rank": 2,
          "speaker": "seeker",
          "text": "Thank you so much for your advice and have a good day.",
          "turn_index": 37
        },
        {
          "owner_id": "p12",
          "reported_at": "2024-07-25",
          "session_id": "esc989",
          "session_rank": 2,
          "speaker": "supporter",
          "text": "My pleasure, you too.",
          "turn_index": 38
        },
        {
          "owner_id": "p12",
          "reported_at": "2024-07-25",
          "session_id": "esc989",
          "session_rank": 2,
          "speaker": "seeker",
          "text": "Bye. closing this chat",
          "turn_index": 39
        },
        {
          "owner_id": "p12",
          "reported_at": "2024-07-25",
          "session_id": "esc989",
          "session_rank": 2,
          "speaker": "supporter",
          "text": "Bye.",
          "turn_index": 40
        }
