          "spans": [
            {
              "end_char": 130,
              "exact_quote": "My parents keep putting pressures on me to be the best in the class and with my learning difficulties I am finding it had to cope ",
              "source_identity": "7d99690522b50c06a4d44d776cb98572d7a4fc3d4ed6bb9786fb73fdc52eca70",
              "source_key": "p11/esc1216:5",
