    {
      "head": "MS",
      "key": "ms::p5::esc652",
      "raw_transcript_identity": "97031304fd4cc45837bdc446080eb5e7f345861bd271706ad57bbbea6a24880a",
      "resource_identity": "4a2661bc0d67a0ef3b8076a6581a99db6a1c3900916f9512b612a8b8c6273fa8",
      "semantic_support": "unverified",
      "status": "located",
      "turns": [
        {
          "owner_id": "p5",
          "reported_at": "2024-06-16",
          "session_id": "esc652",
          "session_rank": 2,
          "speaker": "supporter",
          "text": "Hello. How are you feeling today?",
          "turn_index": 0
        },
        {
          "owner_id": "p5",
          "reported_at": "2024-06-16",
          "session_id": "esc652",
          "session_rank": 2,
          "speaker": "seeker",
          "text": "Hi, I'm feeling really anxious today.",
          "turn_index": 1
        },
        {
          "owner_id": "p5",
          "reported_at": "2024-06-16",
          "session_id": "esc652",
          "session_rank": 2,
          "speaker": "supporter",
          "text": "What has made you feel anxious?",
          "turn_index": 2
        },
        {
          "owner_id": "p5",
          "reported_at": "2024-06-16",
          "session_id": "esc652",
          "session_rank": 2,
          "speaker": "seeker",
          "text": "Yesterday my company laid off 10% of the workforce and another 10% got furloughed.",
          "turn_index": 3
        },
        {
          "owner_id": "p5",
          "reported_at": "2024-06-16",
          "session_id": "esc652",
          "session_rank": 2,
          "speaker": "seeker",
          "text": "I'm afraid I might be in the next round.",
          "turn_index": 4
        },
        {
          "owner_id": "p5",
          "reported_at": "2024-06-16",
          "session_id": "esc652",
          "session_rank": 2,
          "speaker": "supporter",
          "text": "I am very sorry to hear that. I am currently in a situation where furloughs are greatly affecting my family as well.",
          "turn_index": 5
        },
        {
          "owner_id": "p5",
          "reported_at": "2024-06-16",
          "session_id": "esc652",
          "session_rank": 2,
          "speaker": "seeker",
          "text": "Oh no that's terrible.",
          "turn_index": 6
        },
        {
          "owner_id": "p5",
          "reported_at": "2024-06-16",
          "session_id": "esc652",
          "session_rank": 2,
          "speaker": "seeker",
          "text": "The problem is, I am right now the only breadwinner in the family. My wife was laid off three months ago",
          "turn_index": 7
        },
        {
          "owner_id": "p5",
          "reported_at": "2024-06-16",
          "session_id": "esc652",
          "session_rank": 2,
          "speaker": "supporter",
          "text": "Are you given specifics on time of furlough?",
          "turn_index": 8
        },
        {
          "owner_id": "p5",
          "reported_at": "2024-06-16",
          "session_id": "esc652",
          "session_rank": 2,
          "speaker": "seeker",
          "text": "No, it's basically until things get better.",
          "turn_index": 9
        },
        {
          "owner_id": "p5",
          "reported_at": "2024-06-16",
          "session_id": "esc652",
          "session_rank": 2,
          "speaker": "supporter",
          "text": "I know that's very difficult. And no doubt why you're here working for crumbs.",
          "turn_index": 10
        },
        {
          "owner_id": "p5",
          "reported_at": "2024-06-16",
          "session_id": "esc652",
          "session_rank": 2,
          "speaker": "supporter",
          "text": "It's why I'm here as well.",
          "turn_index": 11
        },
        {
          "owner_id": "p5",
          "reported_at": "2024-06-16",
          "session_id": "esc652",
          "session_rank": 2,
          "speaker": "seeker",
          "text": "Yeah, trying to make ends meet wherever I can",
          "turn_index": 12
        },
        {
          "owner_id": "p5",
          "reported_at": "2024-06-16",
          "session_id": "esc652",
          "session_rank": 2,
          "speaker": "seeker",
          "text": "I've been also trying to do uber as well but everyone is doing it also",
          "turn_index": 13
        },
        {
          "owner_id": "p5",
          "reported_at": "2024-06-16",
          "session_id": "esc652",
          "session_rank": 2,
          "speaker": "supporter",
          "text": "I know it's a difficult time. Yes Uber is definitely overrun right now. Have you taken any time out to address your anxiety so it doesn't become more serious? ",
          "turn_index": 14
        },
        {
          "owner_id": "p5",
          "reported_at": "2024-06-16",
          "session_id": "esc652",
          "session_rank": 2,
          "speaker": "seeker",
          "text": "I don't know what I can do. I've been trying to keep busy. And I can't afford a therapist or anything like that.",
          "turn_index": 15
        },
        {
          "owner_id": "p5",
          "reported_at": "2024-06-16",
          "session_id": "esc652",
          "session_rank": 2,
          "speaker": "supporter",
          "text": "Yes, that's definitely an expense you can't afford right now. But are you familiar with the concept of controlled breathing to help reduce or relieve anxiety?",
          "turn_index": 16
        },
        {
          "owner_id": "p5",
          "reported_at": "2024-06-16",
          "session_id": "esc652",
          "session_rank": 2,
          "speaker": "seeker",
          "text": "Like meditation?",
          "turn_index": 17
        },
        {
          "owner_id": "p5",
          "reported_at": "2024-06-16",
          "session_id": "esc652",
          "session_rank": 2,
          "speaker": "seeker",
          "text": "What am I supposed to do? Just breathe in and out a lot?",
          "turn_index": 18
        },
        {
          "owner_id": "p5",
          "reported_at": "2024-06-16",
          "session_id": "esc652",
          "session_rank": 2,
          "speaker": "supporter",
          "text": "Not exactly. Controlled breathing is more of getting yourself into a quiet room. Closing your eyes, and purposely and intently focusing on your breathing. Slowly breathe in for a count of 5, then slowly exhale for a count of 5. Repeat this process for approximately 10 minute. It will help your stress levels and help regulate your heart rate!",
          "turn_index": 19
        },
        {
          "owner_id": "p5",
          "reported_at": "2024-06-16",
          "session_id": "esc652",
          "session_rank": 2,
          "speaker": "seeker",
          "text": "Oh I didn't know that. No, I haven't tried that. Does it really work?",
          "turn_index": 20
        },
        {
          "owner_id": "p5",
          "reported_at": "2024-06-16",
          "session_id": "esc652",
          "session_rank": 2,
          "speaker": "supporter",
          "text": "I've been using it myself over the past 3 months and it most definitely helps! But it's absolutely imperative to clear your mind and have complete quiet.",
          "turn_index": 21
        },
        {
          "owner_id": "p5",
          "reported_at": "2024-06-16",
          "session_id": "esc652",
          "session_rank": 2,
          "speaker": "seeker",
          "text": "ok I can try it I guess",
          "turn_index": 22
        },
        {
          "owner_id": "p5",
          "reported_at": "2024-06-16",
          "session_id": "esc652",
          "session_rank": 2,
          "speaker": "seeker",
          "text": "thanks for that tip",
          "turn_index": 23
        },
        {
          "owner_id": "p5",
          "reported_at": "2024-06-16",
          "session_id": "esc652",
          "session_rank": 2,
          "speaker": "supporter",
          "text": "No problem. I hope this gives you some relief! Stay strong!",
          "turn_index": 24
        },
        {
          "owner_id": "p5",
          "reported_at": "2024-06-16",
          "session_id": "esc652",
          "session_rank": 2,
          "speaker": "seeker",
          "text": "yeah, thanks. same to you",
          "turn_index": 25
        },
        {
          "owner_id": "p5",
          "reported_at": "2024-06-16",
          "session_id": "esc652",
          "session_rank": 2,
          "speaker": "supporter",
          "text": "My final piece of advice would be to set aside time that is specified where nothing negative is discussed. No politics, no bills, nothing anxiety producing for you. It's probably best if this time is within an hour of your bedtime becuase anxiety is not conducive to a good night's sleep.",
          "turn_index": 26
        },
        {
          "owner_id": "p5",
          "reported_at": "2024-06-16",
          "session_id": "esc652",
          "session_rank": 2,
          "speaker": "seeker",
          "text": "That's helpful. Thanks.",
          "turn_index": 27
        },
        {
          "owner_id": "p5",
          "reported_at": "2024-06-16",
          "session_id": "esc652",
          "session_rank": 2,
          "speaker": "supporter",
          "text": "No problem. Take care. Wishing you well on your situation.",
          "turn_index": 28
        },
        {
          "owner_id": "p5",
          "reported_at": "2024-06-16",
          "session_id": "esc652",
          "session_rank": 2,
          "speaker": "seeker",
          "text": "Thanks. You too",
          "turn_index": 29
        }
      ]
    },
    {
      "head": "MS",
      "key": "ms::p5::esc968",
      "raw_transcript_identity": "543eae54467ddbeba284a0b51de323e92e3bcd3a88e362db69e94a25fd288f4e",
      "resource_identity": "d733d19478b4a8f4d4c891f2b2470199a4a3e8ead8334bbf370515f300b6211f",
      "semantic_support": "unverified",
      "status": "located",
      "turns": [
        {
          "owner_id": "p5",
          "reported_at": "2024-06-10",
          "session_id": "esc968",
          "session_rank": 1,
          "speaker": "supporter",
          "text": "Hey there, what's going on today?",
          "turn_index": 0
        },
        {
          "owner_id": "p5",
          "reported_at": "2024-06-10",
          "session_id": "esc968",
          "session_rank": 1,
          "speaker": "seeker",
          "text": "Hello. It is a fine day, how about yourself?",
          "turn_index": 1
        },
        {
          "owner_id": "p5",
          "reported_at": "2024-06-10",
          "session_id": "esc968",
          "session_rank": 1,
          "speaker": "supporter",
          "text": "It really is! I am just taking in the fresh air in the backyard. ",
          "turn_index": 2
        },
        {
          "owner_id": "p5",
          "reported_at": "2024-06-10",
          "session_id": "esc968",
          "session_rank": 1,
          "speaker": "seeker",
          "text": "That is awesome.",
          "turn_index": 3
        },
        {
          "owner_id": "p5",
          "reported_at": "2024-06-10",
          "session_id": "esc968",
          "session_rank": 1,
          "speaker": "supporter",
          "text": "Thanks! What is going on in your neck of the woods? ",
          "turn_index": 4
        },
        {
          "owner_id": "p5",
          "reported_at": "2024-06-10",
          "session_id": "esc968",
          "session_rank": 1,
          "speaker": "seeker",
          "text": "Sort of stuck inside trying to make a dime but it is alright.",
          "turn_index": 5
        },
        {
          "owner_id": "p5",
          "reported_at": "2024-06-10",
          "session_id": "esc968",
          "session_rank": 1,
          "speaker": "supporter",
          "text": "Yeah great minds think alike.. do you do anything else for work? ",
          "turn_index": 6
        },
        {
          "owner_id": "p5",
          "reported_at": "2024-06-10",
          "session_id": "esc968",
          "session_rank": 1,
          "speaker": "seeker",
          "text": "Looking for a good job right now.",
          "turn_index": 7
        },
        {
          "owner_id": "p5",
          "reported_at": "2024-06-10",
          "session_id": "esc968",
          "session_rank": 1,
          "speaker": "seeker",
          "text": "I wanted to talk about a personal issue I have been having, though.",
          "turn_index": 8
        },
        {
          "owner_id": "p5",
          "reported_at": "2024-06-10",
          "session_id": "esc968",
          "session_rank": 1,
          "speaker": "supporter",
          "text": "Okay, you know I'm here for you. Talk to me, what's happening? ",
          "turn_index": 9
        },
        {
          "owner_id": "p5",
          "reported_at": "2024-06-10",
          "session_id": "esc968",
          "session_rank": 1,
          "speaker": "seeker",
          "text": "My father and I had a fight 2 years ago and haven't spoke since.",
          "turn_index": 10
        },
        {
          "owner_id": "p5",
          "reported_at": "2024-06-10",
          "session_id": "esc968",
          "session_rank": 1,
          "speaker": "supporter",
          "text": "The same happened to me, and then my father passed away. If there is anything I can say, is to swallow pride and cherish the moments you have on earth together. What was the fight over?",
          "turn_index": 11
        },
        {
          "owner_id": "p5",
          "reported_at": "2024-06-10",
          "session_id": "esc968",
          "session_rank": 1,
          "speaker": "seeker",
          "text": "Yeah I am afraid that these things can happen. It was only over material things.",
          "turn_index": 12
        },
        {
          "owner_id": "p5",
          "reported_at": "2024-06-10",
          "session_id": "esc968",
          "session_rank": 1,
          "speaker": "supporter",
          "text": "That was my next question, what the fight was over. Do you think he would be open to mending things? ",
          "turn_index": 13
        },
        {
          "owner_id": "p5",
          "reported_at": "2024-06-10",
          "session_id": "esc968",
          "session_rank": 1,
          "speaker": "seeker",
          "text": "It is weird because I called him out for being manipulative so this is his defense. ",
          "turn_index": 14
        },
        {
          "owner_id": "p5",
          "reported_at": "2024-06-10",
          "session_id": "esc968",
          "session_rank": 1,
          "speaker": "supporter",
          "text": "Usually when people feel singled out, they only have a few mechanisms. Unfortunately, most people tend to run away instead of fixing things. It tends to be the easier option. ",
          "turn_index": 15
        },
        {
          "owner_id": "p5",
          "reported_at": "2024-06-10",
          "session_id": "esc968",
          "session_rank": 1,
          "speaker": "seeker",
          "text": "I would likely take advantage of an opportunity to be the bigger person.",
          "turn_index": 16
        },
        {
          "owner_id": "p5",
          "reported_at": "2024-06-10",
          "session_id": "esc968",
          "session_rank": 1,
          "speaker": "supporter",
          "text": "When you try to fix things, just remember that this is his method. I wouldn't hold back on what you have to say, but just word it so that he doesn't feel the need to flee. ",
          "turn_index": 17
        },
        {
          "owner_id": "p5",
          "reported_at": "2024-06-10",
          "session_id": "esc968",
          "session_rank": 1,
          "speaker": "seeker",
          "text": "That is probably decent advice.",
          "turn_index": 18
        },
        {
          "owner_id": "p5",
          "reported_at": "2024-06-10",
          "session_id": "esc968",
          "session_rank": 1,
          "speaker": "supporter",
          "text": "It is HIS responsibility as a parent to want to fix things, but you are also being the bigger person here. I applaud you and hope that he is receptive. ",
          "turn_index": 19
        },
        {
          "owner_id": "p5",
          "reported_at": "2024-06-10",
          "session_id": "esc968",
          "session_rank": 1,
          "speaker": "seeker",
          "text": "I hope so too, but the opportunity seems tenuous ",
          "turn_index": 20
        },
        {
          "owner_id": "p5",
          "reported_at": "2024-06-10",
          "session_id": "esc968",
          "session_rank": 1,
          "speaker": "supporter",
          "text": "How did you guys leave it? ",
          "turn_index": 21
        },
        {
          "owner_id": "p5",
          "reported_at": "2024-06-10",
          "session_id": "esc968",
          "session_rank": 1,
          "speaker": "seeker",
          "text": "Threatening and disparagement haha",
          "turn_index": 22
        },
        {
          "owner_id": "p5",
          "reported_at": "2024-06-10",
          "session_id": "esc968",
          "session_rank": 1,
          "speaker": "supporter",
          "text": "Ha, well after two years, feelings had to have changed. Even a little. Does he live nearby?",
          "turn_index": 23
        },
        {
          "owner_id": "p5",
          "reported_at": "2024-06-10",
          "session_id": "esc968",
          "session_rank": 1,
          "speaker": "seeker",
          "text": "Yeah someday. I think I will have to try you know. THanks for the advice.",
          "turn_index": 24
        }
      ]
    },
    {
      "head": "MS",
      "key": "ms::p5::esc62",
      "raw_transcript_identity": "f00b7d5a0bd2da99ce3f43b3ac0eb72062dd49b78117ef6b9944383c89d0a48f",
      "resource_identity": "9e3d8a76ac130b2e80d3062f6eb06caf4852dde313c2533eaaead6821ba31578",
      "semantic_support": "unverified",
      "status": "located",
      "turns": [
        {
          "owner_id": "p5",
          "reported_at": "2024-05-01",
          "session_id": "esc62",
          "session_rank": 0,
          "speaker": "supporter",
          "text": "Do you need help?",
          "turn_index": 0
        },
        {
          "owner_id": "p5",
          "reported_at": "2024-05-01",
          "session_id": "esc62",
          "session_rank": 0,
          "speaker": "supporter",
          "text": "What is the real issue?",
          "turn_index": 1
        },
        {
          "owner_id": "p5",
          "reported_at": "2024-05-01",
          "session_id": "esc62",
          "session_rank": 0,
          "speaker": "seeker",
          "text": "I don't even know, because I am not happy",
          "turn_index": 2
        },
        {
          "owner_id": "p5",
          "reported_at": "2024-05-01",
          "session_id": "esc62",
          "session_rank": 0,
          "speaker": "seeker",
          "text": "Anxiety about losing my job",
          "turn_index": 3
        },
        {
          "owner_id": "p5",
          "reported_at": "2024-05-01",
          "session_id": "esc62",
          "session_rank": 0,
          "speaker": "supporter",
          "text": "I have been sad at times, but I listen to pleasant music.",
          "turn_index": 4
        },
        {
          "owner_id": "p5",
          "reported_at": "2024-05-01",
          "session_id": "esc62",
          "session_rank": 0,
          "speaker": "supporter",
          "text": "When have you started feeling sad?",
          "turn_index": 5
        },
        {
          "owner_id": "p5",
          "reported_at": "2024-05-01",
          "session_id": "esc62",
          "session_rank": 0,
          "speaker": "supporter",
          "text": "I had fear of losing my job at times.",
          "turn_index": 6
        },
        {
          "owner_id": "p5",
          "reported_at": "2024-05-01",
          "session_id": "esc62",
          "session_rank": 0,
          "speaker": "supporter",
          "text": "I suggest doing stress relieving tasks",
          "turn_index": 7
        },
        {
          "owner_id": "p5",
          "reported_at": "2024-05-01",
          "session_id": "esc62",
          "session_rank": 0,
          "speaker": "seeker",
          "text": "I can't think of that of now, because last three month a go pay cut and nest month payoff ",
          "turn_index": 8
        },
        {
          "owner_id": "p5",
          "reported_at": "2024-05-01",
          "session_id": "esc62",
          "session_rank": 0,
          "speaker": "supporter",
          "text": "Can you repeat that? You had a pay cut in the last three months?",
          "turn_index": 9
        },
        {
          "owner_id": "p5",
          "reported_at": "2024-05-01",
          "session_id": "esc62",
          "session_rank": 0,
          "speaker": "seeker",
          "text": "Yeah and the company is planning layoff for some of the staffs",
          "turn_index": 10
        },
        {
          "owner_id": "p5",
          "reported_at": "2024-05-01",
          "session_id": "esc62",
          "session_rank": 0,
          "speaker": "supporter",
          "text": "How do you know that layoffs are coming?",
          "turn_index": 11
        },
        {
          "owner_id": "p5",
          "reported_at": "2024-05-01",
          "session_id": "esc62",
          "session_rank": 0,
          "speaker": "supporter",
          "text": "Why not try to work for Uber or Lyft to supplement your income?",
          "turn_index": 12
        },
        {
          "owner_id": "p5",
          "reported_at": "2024-05-01",
          "session_id": "esc62",
          "session_rank": 0,
          "speaker": "seeker",
          "text": "They sent circular to all staffs",
          "turn_index": 13
        },
        {
          "owner_id": "p5",
          "reported_at": "2024-05-01",
          "session_id": "esc62",
          "session_rank": 0,
          "speaker": "supporter",
          "text": "What did it state? I am sorry to hear the news.",
          "turn_index": 14
        },
        {
          "owner_id": "p5",
          "reported_at": "2024-05-01",
          "session_id": "esc62",
          "session_rank": 0,
          "speaker": "supporter",
          "text": "Have you looked at updating your resume and looking on job boards?",
          "turn_index": 15
        },
        {
          "owner_id": "p5",
          "reported_at": "2024-05-01",
          "session_id": "esc62",
          "session_rank": 0,
          "speaker": "seeker",
          "text": "No I think I will just do that now may be it will help",
          "turn_index": 16
        },
        {
          "owner_id": "p5",
          "reported_at": "2024-05-01",
          "session_id": "esc62",
          "session_rank": 0,
          "speaker": "supporter",
          "text": "That is a great comment. Being pro-active and looking for similar jobs can help.",
          "turn_index": 17
        },
        {
          "owner_id": "p5",
          "reported_at": "2024-05-01",
          "session_id": "esc62",
          "session_rank": 0,
          "speaker": "seeker",
          "text": "Yeah thanks",
          "turn_index": 18
        },
        {
          "owner_id": "p5",
          "reported_at": "2024-05-01",
          "session_id": "esc62",
          "session_rank": 0,
          "speaker": "supporter",
          "text": "It' good to take initiative and start looking for other sources of income.",
          "turn_index": 19
        },
        {
          "owner_id": "p5",
          "reported_at": "2024-05-01",
          "session_id": "esc62",
          "session_rank": 0,
          "speaker": "seeker",
          "text": "I believe it work if I try.",
          "turn_index": 20
        },
        {
          "owner_id": "p5",
          "reported_at": "2024-05-01",
          "session_id": "esc62",
          "session_rank": 0,
          "speaker": "supporter",
          "text": "I usually search job boards.  It is what I have dine in the past.",
          "turn_index": 21
        },
        {
          "owner_id": "p5",
          "reported_at": "2024-05-01",
          "session_id": "esc62",
          "session_rank": 0,
          "speaker": "supporter",
          "text": "It is important to believe in yourself.",
          "turn_index": 22
        },
        {
          "owner_id": "p5",
          "reported_at": "2024-05-01",
          "session_id": "esc62",
          "session_rank": 0,
          "speaker": "seeker",
          "text": "I am thinking about uber",
          "turn_index": 23
        },
        {
          "owner_id": "p5",
          "reported_at": "2024-05-01",
          "session_id": "esc62",
          "session_rank": 0,
          "speaker": "supporter",
          "text": "I can also suggest Lyft...",
          "turn_index": 24
        },
        {
          "owner_id": "p5",
          "reported_at": "2024-05-01",
          "session_id": "esc62",
          "session_rank": 0,
          "speaker": "supporter",
          "text": "What other feelings and thoughts can I discern for you?",
          "turn_index": 25
        },
        {
          "owner_id": "p5",
          "reported_at": "2024-05-01",
          "session_id": "esc62",
          "session_rank": 0,
          "speaker": "seeker",
          "text": "I can't think of any now thanks for being there for me",
          "turn_index": 26
        },
        {
          "owner_id": "p5",
          "reported_at": "2024-05-01",
          "session_id": "esc62",
          "session_rank": 0,
          "speaker": "seeker",
          "text": "Bye for now",
          "turn_index": 27
        },
        {
          "owner_id": "p5",
          "reported_at": "2024-05-01",
          "session_id": "esc62",
          "session_rank": 0,
          "speaker": "supporter",
          "text": "I think that I can be here to answer.  ",
          "turn_index": 28
        }
      ]
