  "source_turns": {
    "p15/esc1006:0": {
      "owner_id": "p15",
      "session_id": "esc1006",
      "session_rank": 2,
      "turn_index": 0,
      "speaker": "supporter",
      "text": "How is your feeling now?",
      "reported_at": "2024-07-01",
      "identity": "35a41250fd15866daa6b5527365e74b488a1ec8444a0ce1c08ceadda32d2cd45"
    },
    "p15/esc1006:1": {
      "owner_id": "p15",
      "session_id": "esc1006",
      "session_rank": 2,
      "turn_index": 1,
      "speaker": "seeker",
      "text": "I have mixed feelings sad and angry at the same time.",
      "reported_at": "2024-07-01",
      "identity": "26b5f8d339c93dfb044a1ba99412bda5494e83ba8ba1b40df02a507c4b117cb9"
    },
    "p15/esc1006:2": {
      "owner_id": "p15",
      "session_id": "esc1006",
      "session_rank": 2,
      "turn_index": 2,
      "speaker": "supporter",
      "text": "It seems that you are feeling blue and upset by others, right?",
      "reported_at": "2024-07-01",
      "identity": "5b19fd969700f5404b57c3681a7a21355cf619e5d18548e846b6ac69ffb37d27"
    },
    "p15/esc1006:3": {
      "owner_id": "p15",
      "session_id": "esc1006",
      "session_rank": 2,
      "turn_index": 3,
      "speaker": "seeker",
      "text": "Yes. Am sad because I love my mom so much and I never like to get into arguments with her.",
      "reported_at": "2024-07-01",
      "identity": "7c774826f635eda3278cf7140ddb9ecbf97c437a1d797267c06d6dd64e15c928"
    },
    "p15/esc1006:4": {
      "owner_id": "p15",
      "session_id": "esc1006",
      "session_rank": 2,
      "turn_index": 4,
      "speaker": "supporter",
      "text": "From the short conversation, I can feel how sad you are.",
      "reported_at": "2024-07-01",
      "identity": "2828947f45f01e124233af16561df1c8eb51308de01285b2ea847c210da76c1c"
    },
    "p15/esc1006:5": {
      "owner_id": "p15",
      "session_id": "esc1006",
      "session_rank": 2,
      "turn_index": 5,
      "speaker": "seeker",
      "text": "Yes. My mom never approves of most of the things I do.",
      "reported_at": "2024-07-01",
      "identity": "c9d3e7247166ad7d91bc1d684d532e355743a109715916b4bf53de21260ee04c"
    },
    "p15/esc1006:6": {
      "owner_id": "p15",
      "session_id": "esc1006",
      "session_rank": 2,
      "turn_index": 6,
      "speaker": "supporter",
      "text": "What kind of arguments did you have with your mom?",
      "reported_at": "2024-07-01",
      "identity": "196112f0afbecfc560159866fca85d8691a5d191702cfbcb4ae26983fb79dfa5"
    },
    "p15/esc1006:7": {
      "owner_id": "p15",
      "session_id": "esc1006",
      "session_rank": 2,
      "turn_index": 7,
      "speaker": "seeker",
      "text": "Like the kind of friends I should have. I believe I have freedom to choose my friends not her.",
      "reported_at": "2024-07-01",
      "identity": "1783f8a3346353726abb4b622449e15af3494cfb1223fc8aca4cf0d1eb06f8c5"
    },
    "p15/esc1006:8": {
      "owner_id": "p15",
      "session_id": "esc1006",
      "session_rank": 2,
      "turn_index": 8,
      "speaker": "supporter",
      "text": "I had similar situation like yours. My mom did not want me to make friends with some people. ",
      "reported_at": "2024-07-01",
      "identity": "c06ea78fbf80b609cba255662d229e7d59a589f0308d3f3778c0dff230162dd3"
    },
    "p15/esc1006:9": {
      "owner_id": "p15",
      "session_id": "esc1006",
      "session_rank": 2,
      "turn_index": 9,
      "speaker": "seeker",
      "text": "Really? How did you deal with that because for me it makes me angry.",
      "reported_at": "2024-07-01",
      "identity": "5663e7d52558af011ffe295b58b1a626e97029a7aec51bfcb0162c43d4431ab9"
    },
    "p15/esc1138:0": {
      "owner_id": "p15",
      "session_id": "esc1138",
      "session_rank": 1,
      "turn_index": 0,
      "speaker": "seeker",
      "text": "Hello",
      "reported_at": "2024-06-10",
      "identity": "51014364cd54f1869571cc504d6d7b88eb9365eb9d88cc7316d29fee06592002"
    },
    "p15/esc1138:1": {
      "owner_id": "p15",
      "session_id": "esc1138",
      "session_rank": 1,
      "turn_index": 1,
      "speaker": "supporter",
      "text": "Hi, how are you feeling today?",
      "reported_at": "2024-06-10",
      "identity": "f783aba5ae708c97e548667aee4fc1fa6ee5f7aaf5e1f31ea83eda1f00b1a2ea"
    },
    "p15/esc1138:10": {
      "owner_id": "p15",
      "session_id": "esc1138",
      "session_rank": 1,
      "turn_index": 10,
      "speaker": "seeker",
      "text": "I have. It's been a long stressful month of discussion. The problem is I don't share their beliefs, and I haven't been really \"saving myself\". I'm been living away from them for collage quite a while and I've been basically doing stuff that if they found out they would be very upset about.",
      "reported_at": "2024-06-10",
      "identity": "f9b1c2ea597dbf280c9fca48bd0154396bf73e076ade0b886175437a79457391"
    },
    "p15/esc1138:11": {
      "owner_id": "p15",
      "session_id": "esc1138",
      "session_rank": 1,
      "turn_index": 11,
      "speaker": "seeker",
      "text": "But I didn't think it bothers them because they never shared any of this. ",
      "reported_at": "2024-06-10",
      "identity": "be65a81a90c1a658600974a9640690fa7b935f25f653513a75cae11154a760c8"
    },
    "p15/esc1138:12": {
      "owner_id": "p15",
      "session_id": "esc1138",
      "session_rank": 1,
      "turn_index": 12,
      "speaker": "seeker",
      "text": "And they said if I go on this trip I'm disrespecting them and the entire family. ",
      "reported_at": "2024-06-10",
      "identity": "0ad75e5e34612dbb56191aaa2fdec46831268ead608b8d3a8ae390cc7b9dc926"
    },
    "p15/esc1138:13": {
      "owner_id": "p15",
      "session_id": "esc1138",
      "session_rank": 1,
      "turn_index": 13,
      "speaker": "seeker",
      "text": "But his parents are totally cool and don't seem to mind. ",
      "reported_at": "2024-06-10",
      "identity": "6fa2ec5c5d9f275a4986f964fced5ff6f6137a98da3e2839b2326e8e8dba7039"
    },
    "p15/esc1138:14": {
      "owner_id": "p15",
      "session_id": "esc1138",
      "session_rank": 1,
      "turn_index": 14,
      "speaker": "supporter",
      "text": "I get how difficult and upsetting this situation is to you, i have been in a similar situation, however, in my case i took charge of my life, though they are my parents i did what i felt is good for me",
      "reported_at": "2024-06-10",
      "identity": "bdd640fc154d0f55341ed0553238b7067ee3efa420d36b18f461a9716f0d2f98"
    },
    "p15/esc1138:15": {
      "owner_id": "p15",
      "session_id": "esc1138",
      "session_rank": 1,
      "turn_index": 15,
      "speaker": "supporter",
      "text": "Before i continue, do you mind me asking how old you are?",
      "reported_at": "2024-06-10",
      "identity": "99dacba869c635ef1a59341e3d0b838d04fec701ceb84f38d659a79db9d1300f"
    },
    "p15/esc1138:16": {
      "owner_id": "p15",
      "session_id": "esc1138",
      "session_rank": 1,
      "turn_index": 16,
      "speaker": "seeker",
      "text": "I'm 26",
      "reported_at": "2024-06-10",
      "identity": "560aaa0986615c0e74923f54ea99f7e8148ef42f8f903ce0d4e45a4d74e2ae0c"
    },
    "p15/esc1138:17": {
      "owner_id": "p15",
      "session_id": "esc1138",
      "session_rank": 1,
      "turn_index": 17,
      "speaker": "seeker",
      "text": "And I see what you're saying.",
      "reported_at": "2024-06-10",
      "identity": "9fa4776a6af38c72315e0b2b410b949d038fe587a7ce87f1d2bd8ba04ffe89a2"
    },
    "p15/esc1138:18": {
      "owner_id": "p15",
      "session_id": "esc1138",
      "session_rank": 1,
      "turn_index": 18,
      "speaker": "seeker",
      "text": "It's really hard breaking free because they always monitored me my entire life. ",
      "reported_at": "2024-06-10",
      "identity": "ee3c94ba954198882d11c4e9306ef3d2de8607619092d34c8350dc4eda1f7f74"
    },
    "p15/esc1138:19": {
      "owner_id": "p15",
      "session_id": "esc1138",
      "session_rank": 1,
      "turn_index": 19,
      "speaker": "seeker",
      "text": "I never had a voice for myself. They basically bullied and forced me to do what they wanted. ",
      "reported_at": "2024-06-10",
      "identity": "7b508f232469c11473675d2d0218a4d969319f5f5eade454e2d9c3b5b4ce41c5"
    },
    "p15/esc1138:2": {
      "owner_id": "p15",
      "session_id": "esc1138",
      "session_rank": 1,
      "turn_index": 2,
      "speaker": "seeker",
      "text": "I'm feeling a bit confused and anxious. ",
      "reported_at": "2024-06-10",
      "identity": "f8c205aeef96ae9898ad660374e8d35c776eecfc719efb8be9212bb6a9211f16"
    },
    "p15/esc1138:20": {
      "owner_id": "p15",
      "session_id": "esc1138",
      "session_rank": 1,
      "turn_index": 20,
      "speaker": "seeker",
      "text": "BTW if you didn't guess I'm their favorite child. ",
      "reported_at": "2024-06-10",
      "identity": "7684cfed34875f692ad02cd1f5fbc883760e30a03673b8731cb96bf31138de9c"
    },
    "p15/esc1138:21": {
      "owner_id": "p15",
      "session_id": "esc1138",
      "session_rank": 1,
      "turn_index": 21,
      "speaker": "supporter",
      "text": "Okay, you are old enough to be away from your parents, i am going to suggest you sitting with them down and having a heart to heart discussion with them",
      "reported_at": "2024-06-10",
      "identity": "c0af59384b81ac5fcc90c98d457b4574ef92353cd8151d385c6812419b8b455d"
    },
    "p15/esc1138:22": {
      "owner_id": "p15",
      "session_id": "esc1138",
      "session_rank": 1,
      "turn_index": 22,
      "speaker": "supporter",
      "text": "Let them know the consequences of them forcing you, your feelings towards it and how unhappy you are with them restricting you",
      "reported_at": "2024-06-10",
      "identity": "c53b62091345b8b524eb5d9d866584f0aca5c8fed8f5fb03d9dfa587f8aef208"
    },
    "p15/esc1138:23": {
      "owner_id": "p15",
      "session_id": "esc1138",
      "session_rank": 1,
      "turn_index": 23,
      "speaker": "seeker",
      "text": "Should I tell them everything I did that goes against what they believe? ",
      "reported_at": "2024-06-10",
      "identity": "d060e4dd7c2461f843fad566b7f8960d3a8ed8209d91f3208bb8b666938a19fa"
    },
    "p15/esc1138:24": {
      "owner_id": "p15",
      "session_id": "esc1138",
      "session_rank": 1,
      "turn_index": 24,
      "speaker": "seeker",
      "text": "So they know that I don't share their beliefs? ",
      "reported_at": "2024-06-10",
      "identity": "bd281208389c34e5e0aa8913c9c1a24ae3c0738c5ebc6056f18f885f23db296a"
    },
    "p15/esc1138:25": {
      "owner_id": "p15",
      "session_id": "esc1138",
      "session_rank": 1,
      "turn_index": 25,
      "speaker": "supporter",
      "text": "No, i think that should be personal to you, i would not suggest you hurting or making them see you as a disappointment",
      "reported_at": "2024-06-10",
      "identity": "c1ca1cba86dd6344e7d15717560d6295c4c7220837f6f412acf34f161eefe4ad"
    },
    "p15/esc1138:26": {
      "owner_id": "p15",
      "session_id": "esc1138",
      "session_rank": 1,
      "turn_index": 26,
      "speaker": "supporter",
      "text": "I am sure you will be fine after discussing with them, they will come around",
      "reported_at": "2024-06-10",
      "identity": "049ebdbe753f087d25656458367ee1ea97f141c7d0292ca1b29d785601ae84bf"
    },
    "p15/esc1138:27": {
      "owner_id": "p15",
      "session_id": "esc1138",
      "session_rank": 1,
      "turn_index": 27,
      "speaker": "seeker",
      "text": "I guess worst case I won't talk to them for a while : ) ",
      "reported_at": "2024-06-10",
      "identity": "729cf754dd3e9346e8289e3387186e34ffe7e57d2a10f284bffaec87dd7019f4"
    },
    "p15/esc1138:28": {
      "owner_id": "p15",
      "session_id": "esc1138",
      "session_rank": 1,
      "turn_index": 28,
      "speaker": "seeker",
      "text": "Thank you , that helped. ",
      "reported_at": "2024-06-10",
      "identity": "3ef826f4869452f24d84adeba756fe75cc9bd327d2dd9be077b0f9072fa3bb8e"
    },
    "p15/esc1138:29": {
      "owner_id": "p15",
      "session_id": "esc1138",
      "session_rank": 1,
      "turn_index": 29,
      "speaker": "supporter",
      "text": "They might be sad and upset now but they will get over it definitely",
      "reported_at": "2024-06-10",
      "identity": "9852d472baabcd696b52293107039eecc1289b54288bd2f496d1861ae4f7312d"
    },
    "p15/esc1138:3": {
      "owner_id": "p15",
      "session_id": "esc1138",
      "session_rank": 1,
      "turn_index": 3,
      "speaker": "supporter",
      "text": "okay, that is valid, do you have an idea what is causing the confusion?",
      "reported_at": "2024-06-10",
      "identity": "9b5028f50183a1ec43c848373edca5ded35c76963bc9cab5fb311a6bc73d0ec7"
    },
    "p15/esc1138:30": {
      "owner_id": "p15",
      "session_id": "esc1138",
      "session_rank": 1,
      "turn_index": 30,
      "speaker": "supporter",
      "text": "You are welcome",
      "reported_at": "2024-06-10",
      "identity": "9d2647611af26f866c884736e0eced01d6d5820d7347eaa490df7a1a0d820d78"
    },
    "p15/esc1138:31": {
      "owner_id": "p15",
      "session_id": "esc1138",
      "session_rank": 1,
      "turn_index": 31,
      "speaker": "seeker",
      "text": "Have a good one!",
      "reported_at": "2024-06-10",
      "identity": "82608a298b15011441c197c8d73d2fe683f1d2aafc558ace821612386a995159"
    },
    "p15/esc1138:32": {
      "owner_id": "p15",
      "session_id": "esc1138",
      "session_rank": 1,
      "turn_index": 32,
      "speaker": "supporter",
      "text": "You too",
      "reported_at": "2024-06-10",
      "identity": "0bd201d27079cc201051886b7c9ee5175ffaa0a1c75eb5a29cc83dab771948b9"
    },
    "p15/esc1138:4": {
      "owner_id": "p15",
      "session_id": "esc1138",
      "session_rank": 1,
      "turn_index": 4,
      "speaker": "seeker",
      "text": "So I've been dating and my parents are aware. But recently after I said I want to go on a trip with my boyfriend, my parents have all sorts of opinions about it. And all their traditional beliefs that I did not know existed are now on the surface and they are kinda forcing me to follow it. ",
      "reported_at": "2024-06-10",
      "identity": "2c597db1e7890fd88918aace143a1444d792ce51cbe15232b47adef55cbd470b"
    },
    "p15/esc1138:5": {
      "owner_id": "p15",
      "session_id": "esc1138",
      "session_rank": 1,
      "turn_index": 5,
      "speaker": "seeker",
      "text": "For say they think \"bad types of woman\" go on trips with their boyfriends and I need to save myself. ",
      "reported_at": "2024-06-10",
      "identity": "ce15cc1a5f8f8758865493be6b76e79b5a49f4895860e990e04b5263b88ad3c8"
    },
    "p15/esc1138:6": {
      "owner_id": "p15",
      "session_id": "esc1138",
      "session_rank": 1,
      "turn_index": 6,
      "speaker": "seeker",
      "text": "They have been guilt tripping me and I feel very confused.",
      "reported_at": "2024-06-10",
      "identity": "07beb6a96f9d46cb527dbca0e99e13a05dac574038f7e1758ff75bce7738f662"
    },
    "p15/esc1138:7": {
      "owner_id": "p15",
      "session_id": "esc1138",
      "session_rank": 1,
      "turn_index": 7,
      "speaker": "supporter",
      "text": "Your feelings are valid and it is okay to feel confused in this situation considering you love your boyfriend and parents ",
      "reported_at": "2024-06-10",
      "identity": "d2f392c36e0b04a4bd18d0f0c9714cd0fa57a9e2f3a64d5133195b7b22cf6bff"
    },
    "p15/esc1138:8": {
      "owner_id": "p15",
      "session_id": "esc1138",
      "session_rank": 1,
      "turn_index": 8,
      "speaker": "supporter",
      "text": "Have you tried discussing with your boyfriend to talk to your parents as a means of reassuring them?",
      "reported_at": "2024-06-10",
      "identity": "32f34d654d11c9a62c798f5392ff4a17d99f413b37252f23d3129bfeeb8fa4e4"
    },
    "p15/esc1138:9": {
      "owner_id": "p15",
      "session_id": "esc1138",
      "session_rank": 1,
      "turn_index": 9,
      "speaker": "supporter",
      "text": "Or getting someone neutral that your parents trust to talk to them?",
      "reported_at": "2024-06-10",
      "identity": "c9fe8123ffbb94b3c14b78c507e634bc76db19d0cc2f760f0ab178072e4f6c5b"
    },
    "p15/p15_conv_1:0": {
      "owner_id": "p15",
      "session_id": "p15_conv_1",
      "session_rank": 0,
      "turn_index": 0,
      "speaker": "supporter",
      "text": "Hey Kelly, how are you doing today?",
      "reported_at": "2024-03-12",
      "identity": "74540651281282734c19262aca4d936f30f33bab2596f27779656f7debe6831a"
    },
    "p15/p15_conv_1:1": {
      "owner_id": "p15",
      "session_id": "p15_conv_1",
      "session_rank": 0,
      "turn_index": 1,
      "speaker": "seeker",
      "text": "Hey, to be honest, I'm struggling a bit.",
      "reported_at": "2024-03-12",
      "identity": "9bb77af881f8aa96a1f1bb94d96d709afd32b7bdfc8649aa6fb7ebf5e3ae3441"
    },
    "p15/p15_conv_1:10": {
      "owner_id": "p15",
      "session_id": "p15_conv_1",
      "session_rank": 0,
      "turn_index": 10,
      "speaker": "supporter",
      "text": "It's understandable to feel stuck. Sometimes taking a step back can help. Have you tried taking a break from it all?",
      "reported_at": "2024-03-12",
      "identity": "0d46b2058873bb996681fa216b72385f3c79355bd295695c3ec5d39dabdf765f"
    },
    "p15/p15_conv_1:11": {
      "owner_id": "p15",
      "session_id": "p15_conv_1",
      "session_rank": 0,
      "turn_index": 11,
      "speaker": "seeker",
      "text": "I've tried, but it's hard not to think about it. It feels like I'm letting myself down.",
      "reported_at": "2024-03-12",
      "identity": "86264432279712b2f76d0fbb8dff0e7125769d5a3fc0212f197a3e74e04ace32"
    },
    "p15/p15_conv_1:12": {
      "owner_id": "p15",
      "session_id": "p15_conv_1",
      "session_rank": 0,
      "turn_index": 12,
      "speaker": "supporter",
      "text": "You're not letting yourself down. You're doing your best under challenging circumstances. Remember when your friend mentioned overcoming similar doubts in his studies?",
      "reported_at": "2024-03-12",
      "identity": "80399fdf1a881a2f8a83ac267721a3f603284db6f0a9c108a5235837af3cefcf"
    },
    "p15/p15_conv_1:13": {
      "owner_id": "p15",
      "session_id": "p15_conv_1",
      "session_rank": 0,
      "turn_index": 13,
      "speaker": "seeker",
      "text": "Oh yeah, he struggled with something similar and he got through it. It took him a bit of time though.",
      "reported_at": "2024-03-12",
      "identity": "abe4923a512e11fe0997454ef0adea3727227fd764f70ec9ba8c8c6f2f216029"
    },
    "p15/p15_conv_1:14": {
      "owner_id": "p15",
      "session_id": "p15_conv_1",
      "session_rank": 0,
      "turn_index": 14,
      "speaker": "supporter",
      "text": "Exactly. Maybe his story can be a reminder that it's possible to bounce back. Have you reached out to your friends recently?",
      "reported_at": "2024-03-12",
      "identity": "19e878ffeeb778dbc22ab099f1b2cdecdb15efcb6190c747a619081cceda8329"
    },
    "p15/p15_conv_1:15": {
      "owner_id": "p15",
      "session_id": "p15_conv_1",
      "session_rank": 0,
      "turn_index": 15,
      "speaker": "seeker",
      "text": "Not recently. Maybe I should. Talking to someone who understands might help.",
      "reported_at": "2024-03-12",
      "identity": "eb47eef422f05d4e1937f068ba197b496ac495a5a3a265589cb968f910caadb1"
    },
    "p15/p15_conv_1:16": {
      "owner_id": "p15",
      "session_id": "p15_conv_1",
      "session_rank": 0,
      "turn_index": 16,
      "speaker": "supporter",
      "text": "That sounds like a great idea. And remember, I'm always here for you too. You have support.",
      "reported_at": "2024-03-12",
      "identity": "397016cd73228222ffcb563fc0ceb64ae48c9053fc138ced121bde78e5a12005"
    },
    "p15/p15_conv_1:17": {
      "owner_id": "p15",
      "session_id": "p15_conv_1",
      "session_rank": 0,
      "turn_index": 17,
      "speaker": "seeker",
      "text": "Thanks, I really appreciate that. It does help to know I'm not alone in this.",
      "reported_at": "2024-03-12",
      "identity": "81386d2a30b276a71f8e63ceb9d3d92344b8b81c8f0c9f95d2df4dc0dc3ca4b4"
    },
    "p15/p15_conv_1:18": {
      "owner_id": "p15",
      "session_id": "p15_conv_1",
      "session_rank": 0,
      "turn_index": 18,
      "speaker": "supporter",
      "text": "You definitely aren't alone. How about focusing on one small step you can take today?",
      "reported_at": "2024-03-12",
      "identity": "319f80fd92227f78986e25256aaecf75088ce4072cb728df342267496efe1cb8"
    },
    "p15/p15_conv_1:19": {
      "owner_id": "p15",
      "session_id": "p15_conv_1",
      "session_rank": 0,
      "turn_index": 19,
      "speaker": "seeker",
      "text": "Maybe I can start by reviewing the feedback more calmly, with a fresh perspective.",
      "reported_at": "2024-03-12",
      "identity": "e8ab7f00bc45fb85571d45be0a83af00b08e0186b65988f65f8c8d47b391730b"
    },
    "p15/p15_conv_1:2": {
      "owner_id": "p15",
      "session_id": "p15_conv_1",
      "session_rank": 0,
      "turn_index": 2,
      "speaker": "supporter",
      "text": "I'm here to listen. Do you want to share what's been challenging for you?",
      "reported_at": "2024-03-12",
      "identity": "3fbe11c3665c6f4836662130f5cacf4164fb97c0553d2158fcb016a82664854e"
    },
    "p15/p15_conv_1:20": {
      "owner_id": "p15",
      "session_id": "p15_conv_1",
      "session_rank": 0,
      "turn_index": 20,
      "speaker": "supporter",
      "text": "That sounds like a constructive plan. Taking it step by step and being kind to yourself on the journey can make a big difference.",
      "reported_at": "2024-03-12",
      "identity": "d46ee7efe23372135c4d0ec8862683764ab6add1968ffa0266a1e226c03546c6"
    },
    "p15/p15_conv_1:21": {
      "owner_id": "p15",
      "session_id": "p15_conv_1",
      "session_rank": 0,
      "turn_index": 21,
      "speaker": "seeker",
      "text": "I’ll try to keep that in mind. Thank you for listening and helping me process things.",
      "reported_at": "2024-03-12",
      "identity": "f73231b679fee3243782b8cf7b8627687ce2e7ef8249aa9f0586ac2b1c0b8373"
    },
    "p15/p15_conv_1:22": {
      "owner_id": "p15",
      "session_id": "p15_conv_1",
      "session_rank": 0,
      "turn_index": 22,
      "speaker": "supporter",
      "text": "Anytime, Kelly. You’ve got this, even if it doesn’t feel like it right now. Keep reaching out, okay?",
      "reported_at": "2024-03-12",
      "identity": "9904199c40b14cb59efdbc72e70d3e8b75ca46f60883e05769666e13604fdfc0"
    },
    "p15/p15_conv_1:23": {
      "owner_id": "p15",
      "session_id": "p15_conv_1",
      "session_rank": 0,
      "turn_index": 23,
      "speaker": "seeker",
      "text": "I will. Thanks again.",
      "reported_at": "2024-03-12",
      "identity": "1e3f04ab21e3ed47aa10b670df3dd8499dd2c70ba9a04895d76339ac3c403e98"
    },
    "p15/p15_conv_1:3": {
      "owner_id": "p15",
      "session_id": "p15_conv_1",
      "session_rank": 0,
      "turn_index": 3,
      "speaker": "seeker",
      "text": "It's my thesis. I had a setback recently, and it's just really bringing me down.",
