      "identity": "61f87f1ba3beae29c28234c9b15aae7ce475fd5843a73713021b56bfcc6bc5c7"
    },
    "p16/esc915:18": {
      "owner_id": "p16",
      "session_id": "esc915",
      "session_rank": 1,
      "turn_index": 18,
      "speaker": "seeker",
      "text": "Well maybe it could works, to mantain distracted",
