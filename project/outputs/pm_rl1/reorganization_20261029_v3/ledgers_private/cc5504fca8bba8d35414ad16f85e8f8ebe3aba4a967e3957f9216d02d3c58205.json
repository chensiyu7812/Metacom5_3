      "identity": "1c0f00fb4b8671c2fda7e78efa7f46fd348a9411f61c01ff05e93799ce8708f5"
    },
    "p12/esc989:31": {
      "owner_id": "p12",
      "session_id": "esc989",
      "session_rank": 2,
      "turn_index": 31,
      "speaker": "supporter",
      "text": "I used to have sleeping issues, and I started doing this 2 years ago, and I completely changed. I am an investment banker and still am, it is a very stressful environment however this has allowed me to work at the very top and remain in control of my body and mind.",
      "reported_at": "2024-07-25",
      "identity": "b48d93d1d89beffacb1a70a7dc17cd1724ff89d1698ebcabb370b7b711ac41e4"
    },
