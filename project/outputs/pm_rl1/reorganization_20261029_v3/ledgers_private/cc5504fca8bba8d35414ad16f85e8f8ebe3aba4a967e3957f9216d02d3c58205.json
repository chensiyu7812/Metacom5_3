      "owner_id": "p12",
      "session_id": "esc894",
      "session_rank": 0,
      "turn_index": 11,
      "speaker": "supporter",
      "text": "Have you tried doing activities that help distract you from having negative thoughts?",
      "reported_at": "2024-06-10",
