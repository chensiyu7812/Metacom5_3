      "owner_id": "p12",
      "session_id": "esc989",
      "session_rank": 2,
      "turn_index": 32,
      "speaker": "supporter",
      "text": "Please try this for 1 week, I know you can do it and I know it will help you long term.",
      "reported_at": "2024-07-25",
      "identity": "7ebbe215613492da7623d561425d9f57d3b1e80f5723f5462fb80f68aa210097"
    },
