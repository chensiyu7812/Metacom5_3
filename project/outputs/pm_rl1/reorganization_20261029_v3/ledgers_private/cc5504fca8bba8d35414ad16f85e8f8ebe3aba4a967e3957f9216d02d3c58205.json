      "owner_id": "p12",
      "session_id": "esc989",
      "session_rank": 2,
      "turn_index": 29,
      "speaker": "supporter",
      "text": "I would recommend trying to practice 30m-1h of yoga (you can find lodes of exercise videos on the internet to follow), followed by a mediation sound track for you to listen to in bed while you try to sleep.",
      "reported_at": "2024-07-25",
      "identity": "812cd9fd16d12f83f6688128d49bb06f14ddd257e97403abdee930bd7c53212f"
    },
    "p12/esc989:3": {
      "owner_id": "p12",
      "session_id": "esc989",
      "session_rank": 2,
      "turn_index": 3,
      "speaker": "seeker",
      "text": "Daily am not able to sleep on time",
      "reported_at": "2024-07-25",
      "identity": "5ec262353a657b9e88b6eb812aaf0d7b2749cacc93fea0239d9e3405195ebe6a"
    },
    "p12/esc989:30": {
      "owner_id": "p12",
      "session_id": "esc989",
      "session_rank": 2,
      "turn_index": 30,
      "speaker": "supporter",
      "text": "Keep your body and mind clear before you go to sleep has proven to allow for a better sleep.",
