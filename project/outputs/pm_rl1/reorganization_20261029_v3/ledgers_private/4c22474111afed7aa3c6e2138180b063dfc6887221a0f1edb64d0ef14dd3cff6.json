    "p11/esc768:35": {
      "owner_id": "p11",
      "session_id": "esc768",
      "session_rank": 1,
      "turn_index": 35,
      "speaker": "supporter",
      "text": "Yes getting lost in a good book is a great way to get your mind off of it!",
