      "session_id": "esc410",
      "session_rank": 1,
      "turn_index": 9,
      "speaker": "seeker",
      "text": "How did your dog come with the house?",
      "reported_at": "2024-07-06",
      "identity": "542a64967ac2582e1d26059b8676c9319969871c2406d4fe8aacfe8881bbe360"
    },
