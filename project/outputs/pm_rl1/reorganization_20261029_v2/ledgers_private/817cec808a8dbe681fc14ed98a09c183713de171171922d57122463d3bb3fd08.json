  "audience": "construction_evaluator_only",
  "source_turns": {
    "p13/esc410:0": {
      "owner_id": "p13",
      "session_id": "esc410",
      "session_rank": 1,
      "turn_index": 0,
      "speaker": "supporter",
      "text": "Hi! How are you tonight?",
      "reported_at": "2024-07-06",
      "identity": "138f4436fe05a8c9d2903446612b1a6232051f28e4a699e8cb7c0b2d8d34292e"
    },
    "p13/esc410:1": {
      "owner_id": "p13",
      "session_id": "esc410",
      "session_rank": 1,
      "turn_index": 1,
      "speaker": "seeker",
      "text": "I've been better. I just buried my dog yesterday",
      "reported_at": "2024-07-06",
      "identity": "031e1c348ddff19fa359483c8938d3a61eb3ee300f1054d5509ca7066fe8a1bf"
    },
    "p13/esc410:10": {
      "owner_id": "p13",
      "session_id": "esc410",
      "session_rank": 1,
      "turn_index": 10,
      "speaker": "supporter",
      "text": "Was that your only pet? Or do you have others? We moved from FL to KY and the little dog just hung out here, he really belonged to the neighbor's son who didn't want him, so he just ran around wild and wouldn't leave. I never had a dog, but it got cold, so i took him in. They never asked about him and after a week, I asked them if I could have the dog, so they said yes. I don't think they cared.",
      "reported_at": "2024-07-06",
      "identity": "faad33f9e98aa3ec2ea43e2a4d867e1a1c1bf084e17c36c2fa18213dade4ca7d"
    },
    "p13/esc410:11": {
      "owner_id": "p13",
      "session_id": "esc410",
      "session_rank": 1,
      "turn_index": 11,
      "speaker": "supporter",
      "text": "I wish I could give you a hug, really, there are no words to make this better as you already know the grief of losing a pet, it does get better, but it stings terribly at first.",
      "reported_at": "2024-07-06",
      "identity": "b19f81df97e352c7ccf3d1c3a99ed0381a6ed0a4089241ff82f31497cd289e8e"
    },
    "p13/esc410:12": {
      "owner_id": "p13",
      "session_id": "esc410",
      "session_rank": 1,
      "turn_index": 12,
      "speaker": "seeker",
      "text": "I have 2 other dogs that are mine and my boyfriend has 2",
      "reported_at": "2024-07-06",
      "identity": "79575003bfb139842e7365ea791c3b7c8edfe9ae5ce06f6643e1b6a55d16d88d"
    },
    "p13/esc410:13": {
      "owner_id": "p13",
      "session_id": "esc410",
      "session_rank": 1,
      "turn_index": 13,
      "speaker": "seeker",
      "text": "Thank you. that means a lot",
      "reported_at": "2024-07-06",
      "identity": "a35be842a34524b65794be27076d2452b5b7bf661b363a227f94f027097c2b83"
    },
    "p13/esc410:14": {
      "owner_id": "p13",
      "session_id": "esc410",
      "session_rank": 1,
      "turn_index": 14,
      "speaker": "seeker",
      "text": "We both had dogs when we met.",
      "reported_at": "2024-07-06",
      "identity": "997d3ea3e05faa03d0aeabf20f1b24e6e9b999e08a90df8fc41c9902ddd49f74"
    },
    "p13/esc410:15": {
      "owner_id": "p13",
      "session_id": "esc410",
      "session_rank": 1,
      "turn_index": 15,
      "speaker": "supporter",
      "text": "So you definitely are a dog lover! I was in my 50s before I ever had a dog, now I wish I had more, they are really loving. Not like cats who don't care much about much except FOOD! lol",
      "reported_at": "2024-07-06",
      "identity": "09368a79a301ec18d1b2946bdb707381bcccc17cc35511515fae6e3eb65f69fd"
    },
    "p13/esc410:16": {
      "owner_id": "p13",
      "session_id": "esc410",
      "session_rank": 1,
      "turn_index": 16,
      "speaker": "supporter",
      "text": "I know when tragedy happens, I can't get stuck in depression, I sort of have to force myself to put one foot in front of the other. It's hard to have a healthy balance between grieving and continuing to live. Cry, then dry my eyes, pick up, go for a walk, don't get caught in grief, but yet don't deny it! ",
      "reported_at": "2024-07-06",
      "identity": "7783006f1bf3c1996f519efebdb1ed5a192578afaa0d2a013c05386f1121bdd0"
    },
    "p13/esc410:17": {
      "owner_id": "p13",
      "session_id": "esc410",
      "session_rank": 1,
      "turn_index": 17,
      "speaker": "seeker",
      "text": "They get to be so close and you can really pick up on their emotions and stuff. That's what happens to me. I get stuck sometimes",
      "reported_at": "2024-07-06",
      "identity": "df7e95f6c9aa334f146710eb688bf3b7542c0755c84ca835645086b6f78ecbba"
    },
    "p13/esc410:18": {
      "owner_id": "p13",
      "session_id": "esc410",
      "session_rank": 1,
      "turn_index": 18,
      "speaker": "supporter",
      "text": "I get stuck too. But you are doing the right things, here you reached out to someone and I do care, so you are moving forward.",
      "reported_at": "2024-07-06",
      "identity": "67c163a1bb7e33c5a825b1c05f5f576171b0cbc8a1bb87690727e281fa5f8b05"
    },
    "p13/esc410:19": {
      "owner_id": "p13",
      "session_id": "esc410",
      "session_rank": 1,
      "turn_index": 19,
      "speaker": "supporter",
      "text": "I always find it helpful just so have someone share my pain with me. Just to know I'm  not alone.",
      "reported_at": "2024-07-06",
      "identity": "76088fe9e54711c650f36804656d95ec549aea557849b38e484617fc0529930c"
    },
    "p13/esc410:2": {
      "owner_id": "p13",
      "session_id": "esc410",
      "session_rank": 1,
      "turn_index": 2,
      "speaker": "seeker",
      "text": "She was going to turn 15 next month",
      "reported_at": "2024-07-06",
      "identity": "c762a13347689b5edcc86723f082c792bbcb96ac3d46e28ec6fa91e9ce476cb3"
    },
    "p13/esc410:20": {
      "owner_id": "p13",
      "session_id": "esc410",
      "session_rank": 1,
      "turn_index": 20,
      "speaker": "seeker",
      "text": "Thanks. Another person who has pets helps",
      "reported_at": "2024-07-06",
      "identity": "3c1231b83a8a42a764fb5ad9689f1c40d191d9910a6fc39d9210a08dc19cd155"
    },
    "p13/esc410:21": {
      "owner_id": "p13",
      "session_id": "esc410",
      "session_rank": 1,
      "turn_index": 21,
      "speaker": "seeker",
      "text": "They understand",
      "reported_at": "2024-07-06",
      "identity": "885dafc93067b9b19ca5b0f3724626a005db11a622cbe74ed4d4cf1480f8f293"
    },
    "p13/esc410:22": {
      "owner_id": "p13",
      "session_id": "esc410",
      "session_rank": 1,
      "turn_index": 22,
      "speaker": "supporter",
      "text": "I do understand. My mom died in 2010, right after she died, 1 of my cats died, my husband went into the hospital and almost died, so we went on vacation so I would not be consumed with grief, and do you know, we brought our pets and our cat died when we arrived here on vacation?  I will never forget that. You know what. I knew I could either get consumed in grief, or push through. Man, that was hard. I prayed a lot and God got me through that and I had a good vacation, all things considered.",
      "reported_at": "2024-07-06",
      "identity": "fa975ca3e33fdbe214788b475c0691f66fd3500f300fb4652a35c0384e3309c9"
    },
    "p13/esc410:23": {
      "owner_id": "p13",
      "session_id": "esc410",
      "session_rank": 1,
      "turn_index": 23,
      "speaker": "supporter",
      "text": "I will definitely pray for you too that God will comfort your heart and that you will be comforted by your other dogs and your boyfriend's dogs and that you will feel joy at times at the happy memories you had with your dog. ",
      "reported_at": "2024-07-06",
      "identity": "7529ab75b1e8e30664a1a822d1f0f2c67ccb932985c4b80a9a0bffac19328a35"
    },
    "p13/esc410:24": {
      "owner_id": "p13",
      "session_id": "esc410",
      "session_rank": 1,
      "turn_index": 24,
      "speaker": "seeker",
      "text": "Oh wow, that sounds horrible. Pushing through though I guess is all one can do then. Thank you so much. I believe in prayer.",
      "reported_at": "2024-07-06",
      "identity": "89a91b7cb112fe9a3b6c6c5bee6d0c83076fe4d9816a038eb4b5366f9435b66f"
    },
    "p13/esc410:25": {
      "owner_id": "p13",
      "session_id": "esc410",
      "session_rank": 1,
      "turn_index": 25,
      "speaker": "supporter",
      "text": "Prayer is what gets me through every day!  :D  It was rough, but I believe these hard times strengthen us in some way. Because life throws hard balls, and we have to move forward or be consumed. ",
      "reported_at": "2024-07-06",
      "identity": "1e7932b9bf97aeee8f9f450e66464fdfdddd71e0a6c2f74477c30677f147f0fa"
    },
    "p13/esc410:26": {
      "owner_id": "p13",
      "session_id": "esc410",
      "session_rank": 1,
      "turn_index": 26,
      "speaker": "seeker",
      "text": "That's true. I'm glad I did this project. You really helped me.",
      "reported_at": "2024-07-06",
      "identity": "f80e2f2a680e750619249937c35a20a61702dedf165845702370bc42da5d7096"
    },
    "p13/esc410:27": {
      "owner_id": "p13",
      "session_id": "esc410",
      "session_rank": 1,
      "turn_index": 27,
      "speaker": "supporter",
      "text": "I'm so glad I did too. It was a pleasure to meet you. And once again, (hug). :D",
      "reported_at": "2024-07-06",
      "identity": "0961e96d55ff9ad80c5c5e39e04ee6dba7e6e8539d054009f0c59ce26e62e341"
    },
    "p13/esc410:28": {
      "owner_id": "p13",
      "session_id": "esc410",
      "session_rank": 1,
      "turn_index": 28,
      "speaker": "seeker",
      "text": "You too. Thanks so much. bye",
      "reported_at": "2024-07-06",
      "identity": "d4e814642dece68459d1169ec19985e22359c3ae6541879f013aa8ce6425edba"
    },
    "p13/esc410:29": {
      "owner_id": "p13",
      "session_id": "esc410",
      "session_rank": 1,
      "turn_index": 29,
      "speaker": "supporter",
      "text": "I have one more thing to say - wise words from this 92 year old lady at church named Sue. She told me this after my brother died. When you get older, everyone you know is practically dead.  She said \"Life is for the living, if you get caught up to much in all the death, you won't life.\"  True words. God bless, have a good night.  ",
      "reported_at": "2024-07-06",
      "identity": "767b276b9e217779abf5a0a245908b9ea35b253a5ca6c134f8317ca40a918861"
    },
    "p13/esc410:3": {
      "owner_id": "p13",
      "session_id": "esc410",
      "session_rank": 1,
      "turn_index": 3,
      "speaker": "supporter",
      "text": "Ouch! I'm so sorry to hear that. I never lost a dog, but I've lost cats. ",
      "reported_at": "2024-07-06",
      "identity": "ee172ce44efabd581fc8811c8a96ba3fecfad142634cfe1c9e3b902444026934"
    },
    "p13/esc410:4": {
      "owner_id": "p13",
      "session_id": "esc410",
      "session_rank": 1,
      "turn_index": 4,
      "speaker": "supporter",
      "text": "Is 14 a good age for a dog?",
      "reported_at": "2024-07-06",
      "identity": "1ac5e66e7f807b56cd0e1b798588853e0ba879a3d93d8ecbf60b9121b3eb7eda"
    },
    "p13/esc410:5": {
      "owner_id": "p13",
      "session_id": "esc410",
      "session_rank": 1,
      "turn_index": 5,
      "speaker": "supporter",
      "text": "I have my first dog so I don't know much, he is 9 years old and came with our house. ",
      "reported_at": "2024-07-06",
      "identity": "25cd3e10bd52f3187b5911d41b3c1ecfba697514b574df600cd59b08fcae7acb"
    },
    "p13/esc410:6": {
      "owner_id": "p13",
      "session_id": "esc410",
      "session_rank": 1,
      "turn_index": 6,
      "speaker": "seeker",
      "text": "Actually, yes. She was old and had dementia.",
      "reported_at": "2024-07-06",
      "identity": "367cb5a0d504d09e0d1383f0e36ce0fa76d0c29bbcd8cfd0ec9bf5882cbea225"
    },
    "p13/esc410:7": {
      "owner_id": "p13",
      "session_id": "esc410",
      "session_rank": 1,
      "turn_index": 7,
      "speaker": "seeker",
      "text": "The oldest dog I evet had was 15",
      "reported_at": "2024-07-06",
      "identity": "de8a8ff0aceaae6b5a0db2d00e00f7826ca61763dfbd6da256994cbf902eea74"
    },
    "p13/esc410:8": {
      "owner_id": "p13",
      "session_id": "esc410",
      "session_rank": 1,
      "turn_index": 8,
      "speaker": "supporter",
      "text": "I'm so sorry, losing a pet is very hard on us. ",
      "reported_at": "2024-07-06",
      "identity": "f86f120c48a00cec2ad0421e73ba4107e3ed437b80ebd1d084d06f0bc962601f"
    },
    "p13/esc410:9": {
