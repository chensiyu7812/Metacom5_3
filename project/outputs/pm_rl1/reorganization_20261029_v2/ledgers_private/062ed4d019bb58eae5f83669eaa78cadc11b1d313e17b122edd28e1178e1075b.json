    "p3/esc207:14": {
      "owner_id": "p3",
      "session_id": "esc207",
      "session_rank": 0,
      "turn_index": 14,
      "speaker": "supporter",
      "text": "I assume that means you're in college then? So the stress of finals is over now?",
