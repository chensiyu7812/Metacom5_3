    "p3/esc207:12": {
      "owner_id": "p3",
      "session_id": "esc207",
      "session_rank": 0,
      "turn_index": 12,
      "speaker": "supporter",
      "text": "Well I'm glad to hear it, sounds like you've been managing pretty well then.  ",
