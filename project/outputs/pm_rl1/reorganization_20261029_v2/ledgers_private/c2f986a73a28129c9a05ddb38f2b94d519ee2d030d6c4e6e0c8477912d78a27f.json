      "session_id": "esc1212",
      "session_rank": 1,
      "turn_index": 17,
      "speaker": "supporter",
      "text": "You are welcome, I am here for you. ",
      "reported_at": "2024-06-15",
      "identity": "d96df13be4a67f897757da3a87abc2a3c5d1d2e4f209f1867e68b0450ad2e49a"
    },
    "p12/esc1212:2": {
      "owner_id": "p12",
      "session_id": "esc1212",
      "session_rank": 1,
      "turn_index": 2,
      "speaker": "seeker",
      "text": "i need som help, i feel so sad.",
      "reported_at": "2024-06-15",
      "identity": "e71b753c0455e18617971ffe44861ac39eb16b4ebc1eb234f167c8404ebdce09"
    },
    "p12/esc1212:3": {
      "owner_id": "p12",
      "session_id": "esc1212",
      "session_rank": 1,
      "turn_index": 3,
      "speaker": "supporter",
      "text": "I am sorry to hear that. Is there anything I can do for you? Please tell me what's wrong?",
      "reported_at": "2024-06-15",
      "identity": "904a1078c6a2b70f9f02548cb2892f8c99d529dc9c6b02da5fb2815bf9470d86"
    },
    "p12/esc1212:4": {
      "owner_id": "p12",
      "session_id": "esc1212",
      "session_rank": 1,
      "turn_index": 4,
      "speaker": "seeker",
      "text": "I think you can talk to me, maybe I will feel a bit better.",
      "reported_at": "2024-06-15",
      "identity": "b64e6fec237644d605bef67269e492b8fa951d056a4fdaccfe3183915a9d82cf"
    },
    "p12/esc1212:5": {
      "owner_id": "p12",
      "session_id": "esc1212",
      "session_rank": 1,
      "turn_index": 5,
      "speaker": "seeker",
      "text": "I had a breakup with my boyfriend. ",
      "reported_at": "2024-06-15",
      "identity": "87b1f618a4a1efd8a5ad16fc8c329d23037f73b7e5c240e269e0705fb7df5fd6"
    },
    "p12/esc1212:6": {
      "owner_id": "p12",
      "session_id": "esc1212",
      "session_rank": 1,
      "turn_index": 6,
      "speaker": "seeker",
      "text": "Feeling depressed, can you give me any advice?",
      "reported_at": "2024-06-15",
      "identity": "df0966261e20c16389ccb2f398c6153a8b77d3075c9fde76d5728b36856b921d"
    },
    "p12/esc1212:7": {
      "owner_id": "p12",
      "session_id": "esc1212",
      "session_rank": 1,
      "turn_index": 7,
      "speaker": "supporter",
      "text": "For sure, I am happy to talk to you. I am sorry for your breakup. ",
      "reported_at": "2024-06-15",
      "identity": "a4bdf60b0e6e97351e2f47070d2f958f052a6fe03995d314945b985833898a5b"
    },
    "p12/esc1212:8": {
      "owner_id": "p12",
      "session_id": "esc1212",
      "session_rank": 1,
      "turn_index": 8,
      "speaker": "seeker",
      "text": "Thank you, but  I do not feel motivated to do anything. What should i do with my feelings?",
      "reported_at": "2024-06-15",
      "identity": "f431e298fab68006ef667106d535ce0e57bd5739d6c93aad5574c739c05db511"
    },
    "p12/esc1212:9": {
      "owner_id": "p12",
      "session_id": "esc1212",
      "session_rank": 1,
      "turn_index": 9,
      "speaker": "supporter",
      "text": "Is there anything you want to do right now that helps maybe. For example, to eat something, to listen good music or take small walk in fresh air etc",
      "reported_at": "2024-06-15",
      "identity": "fb7d95579204ff280e562c962b3faeb40039e0a5bd4b0dd8df3dc430eb9a9376"
    },
    "p12/esc894:0": {
      "owner_id": "p12",
      "session_id": "esc894",
      "session_rank": 0,
      "turn_index": 0,
      "speaker": "supporter",
      "text": "Hello, what can I help you?",
