    "p12/esc894:10": {
      "owner_id": "p12",
      "session_id": "esc894",
      "session_rank": 0,
      "turn_index": 10,
      "speaker": "supporter",
      "text": "It is understandable to have that reaction. I agree with you, only us can hep ourselves.",
      "reported_at": "2024-06-10",
      "identity": "be053549fbfb36ba010d9bcb4b0432a9de4ffc26bf392283e8fe69741e93048d"
    },
    "p12/esc894:11": {
      "owner_id": "p12",
      "session_id": "esc894",
      "session_rank": 0,
      "turn_index": 11,
      "speaker": "supporter",
      "text": "Have you tried doing activities that help distract you from having negative thoughts?",
      "reported_at": "2024-06-10",
      "identity": "f0717b39aac6b13d3b38d040e4f857ea3d804bafe745c40ed695dc11fa3f9623"
    },
    "p12/esc894:12": {
      "owner_id": "p12",
      "session_id": "esc894",
      "session_rank": 0,
      "turn_index": 12,
      "speaker": "seeker",
      "text": "Kind of, most of it involves eating loads of ice cream LOL. ",
