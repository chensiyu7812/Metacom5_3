    "p12/esc894:1": {
      "owner_id": "p12",
      "session_id": "esc894",
      "session_rank": 0,
      "turn_index": 1,
      "speaker": "seeker",
      "text": "I really sad as my partner walked out on me. Any thoughts what could  cheer me up?",
      "reported_at": "2024-06-10",
      "identity": "ad8018c9317e3e3eee3a5c623f52e15ce456e56d1db7ae097c8040cac8ac5225"
