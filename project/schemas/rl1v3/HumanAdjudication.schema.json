{
  "$id": "urn:metacom:rl1v3:pmrl1v3-contracts-0.2.0:HumanAdjudication",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "reason": {
      "minLength": 1,
      "title": "Reason",
      "type": "string"
    },
    "record_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Record Sha256",
      "type": "string"
    },
    "record_uri": {
      "minLength": 1,
      "title": "Record Uri",
      "type": "string"
    },
    "response_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Response Sha256",
      "type": "string"
    },
    "reviewer_id": {
      "minLength": 1,
      "title": "Reviewer Id",
      "type": "string"
    },
    "schema_version": {
      "const": "pmrl1v3-contracts-0.2.0",
      "default": "pmrl1v3-contracts-0.2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "verdict": {
      "enum": [
        "pass",
        "fail",
        "uncertain"
      ],
      "title": "Verdict",
      "type": "string"
    }
  },
  "required": [
    "reviewer_id",
    "record_uri",
    "record_sha256",
    "response_sha256",
    "verdict",
    "reason",
    "schema_version"
  ],
  "title": "HumanAdjudication",
  "type": "object"
}
