{
  "$defs": {
    "SourceSpan": {
      "additionalProperties": false,
      "properties": {
        "end_char": {
          "exclusiveMinimum": 0,
          "title": "End Char",
          "type": "integer"
        },
        "exact_quote": {
          "minLength": 1,
          "title": "Exact Quote",
          "type": "string"
        },
        "owner_id": {
          "minLength": 1,
          "title": "Owner Id",
          "type": "string"
        },
        "raw_turn_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Raw Turn Sha256",
          "type": "string"
        },
        "schema_version": {
          "const": "pmrl1v3-contracts-0.2.0",
          "default": "pmrl1v3-contracts-0.2.0",
          "title": "Schema Version",
          "type": "string"
        },
        "session_id": {
          "minLength": 1,
          "title": "Session Id",
          "type": "string"
        },
        "source_key": {
          "minLength": 1,
          "title": "Source Key",
          "type": "string"
        },
        "source_rank": {
          "minimum": 0,
          "title": "Source Rank",
          "type": "integer"
        },
        "speaker": {
          "enum": [
            "seeker",
            "supporter"
          ],
          "title": "Speaker",
          "type": "string"
        },
        "start_char": {
          "minimum": 0,
          "title": "Start Char",
          "type": "integer"
        },
        "turn_index": {
          "minimum": 0,
          "title": "Turn Index",
          "type": "integer"
        }
      },
      "required": [
        "source_key",
        "owner_id",
        "session_id",
        "source_rank",
        "turn_index",
        "speaker",
        "start_char",
        "end_char",
        "exact_quote",
        "raw_turn_sha256",
        "schema_version"
      ],
      "title": "SourceSpan",
      "type": "object"
    },
    "TimePoint": {
      "additionalProperties": false,
      "description": "Null calendar date never means epoch; at least one coordinate is known.",
      "properties": {
        "date": {
          "anyOf": [
            {
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Date"
        },
        "schema_version": {
          "const": "pmrl1v3-contracts-0.2.0",
          "default": "pmrl1v3-contracts-0.2.0",
          "title": "Schema Version",
          "type": "string"
        },
        "session_rank": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Session Rank"
        }
      },
      "required": [
        "schema_version"
      ],
      "title": "TimePoint",
      "type": "object"
    }
  },
  "$id": "urn:metacom:rl1v3:pmrl1v3-contracts-0.2.0:TemporalClaim",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "claim_id": {
      "minLength": 1,
      "title": "Claim Id",
      "type": "string"
    },
    "epistemic_status": {
      "enum": [
        "user_reported",
        "supporter_suggestion",
        "reported_intention",
        "inferred_unverified",
        "unknown"
      ],
      "title": "Epistemic Status",
      "type": "string"
    },
    "event_time": {
      "anyOf": [
        {
          "$ref": "#/$defs/TimePoint"
        },
        {
          "type": "null"
        }
      ]
    },
    "evidence_spans": {
      "items": {
        "$ref": "#/$defs/SourceSpan"
      },
      "minItems": 1,
      "title": "Evidence Spans",
      "type": "array"
    },
    "head": {
      "enum": [
        "MP",
        "ME"
      ],
      "title": "Head",
      "type": "string"
    },
    "invalidated_knowledge_rank": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Invalidated Knowledge Rank"
    },
    "invalidation_source_refs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/SourceSpan"
      },
      "title": "Invalidation Source Refs",
      "type": "array"
    },
    "object": {
      "minLength": 1,
      "title": "Object",
      "type": "string"
    },
    "predicate": {
      "minLength": 1,
      "title": "Predicate",
      "type": "string"
    },
    "reported_at": {
      "$ref": "#/$defs/TimePoint"
    },
    "schema_version": {
      "const": "pmrl1v3-contracts-0.2.0",
      "default": "pmrl1v3-contracts-0.2.0",
      "title": "Schema Version",
      "type": "string"
    },
    "semantic_support": {
      "enum": [
        "unverified",
        "supported",
        "uncertain",
        "rejected"
      ],
      "title": "Semantic Support",
      "type": "string"
    },
    "source_rank": {
      "minimum": 0,
      "title": "Source Rank",
      "type": "integer"
    },
    "subject_id": {
      "minLength": 1,
      "title": "Subject Id",
      "type": "string"
    },
    "valid_from": {
      "anyOf": [
        {
          "$ref": "#/$defs/TimePoint"
        },
        {
          "type": "null"
        }
      ]
    },
    "valid_to": {
      "anyOf": [
        {
          "$ref": "#/$defs/TimePoint"
        },
        {
          "type": "null"
        }
      ]
    },
    "version_group": {
      "minLength": 1,
      "title": "Version Group",
      "type": "string"
    }
  },
  "required": [
    "claim_id",
    "head",
    "subject_id",
    "predicate",
    "object",
    "reported_at",
    "source_rank",
    "event_time",
    "valid_from",
    "valid_to",
    "invalidated_knowledge_rank",
    "epistemic_status",
    "evidence_spans",
    "semantic_support",
    "version_group",
    "schema_version"
  ],
  "title": "TemporalClaim",
  "type": "object"
}
