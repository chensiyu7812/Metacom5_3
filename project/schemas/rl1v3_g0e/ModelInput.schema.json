{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pmrl1v3:g0e-model-input:1",
  "title": "G0eModelInputV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "messages",
    "input_ids",
    "decode"
  ],
  "properties": {
    "messages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "content"
        ],
        "properties": {
          "role": {
            "enum": [
              "system",
              "user",
              "assistant"
            ]
          },
          "content": {
            "type": "string"
          }
        }
      }
    },
    "input_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "integer",
        "minimum": 0
      }
    },
    "decode": {
      "const": {
        "do_sample": false,
        "enable_thinking": false,
        "eos_token_id": [
          1,
          106,
          50
        ],
        "max_new_tokens": 320,
        "num_beams": 1,
        "pad_token_id": 0,
        "repetition_penalty": 1.0,
        "seed": 0,
        "suppress_tokens": [
          258883,
          258882
        ]
      }
    }
  }
}
