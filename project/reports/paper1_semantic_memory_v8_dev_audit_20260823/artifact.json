  "sources": [
    {
      "id": "summary_source",
      "label": "Frozen v8 DEV matrix summary",
      "path": "project/data/paper1_authority/paper1_semantic_memory_v8_dev_matrix_20260820_v1.jsonl",
      "query": {
        "engine": "SQLite 3 in-memory audit",
        "sql": "SELECT\n  COUNT(*) AS items,\n  SUM(CASE WHEN old_human_label = 'PASS' THEN 1 ELSE 0 END) AS old_pass_total,\n  SUM(CASE WHEN old_human_label = 'PASS' AND deterministic_v8_verdict = 'ACCEPT' THEN 1 ELSE 0 END) AS old_pass_retained,\n  SUM(CASE WHEN old_human_label IN ('FAIL','REVIEW') THEN 1 ELSE 0 END) AS known_fail_review_total,\n  SUM(CASE WHEN old_human_label IN ('FAIL','REVIEW') AND deterministic_v8_verdict != 'ACCEPT' THEN 1 ELSE 0 END) AS known_fail_review_rejected,\n  SUM(outcome_calls) AS outcome_calls\nFROM v8_dev_matrix",
        "description": "Counts frozen v8 DEV items and descriptive retention/rejection rates.",
        "tables_used": [
          "v8_dev_matrix"
        ],
        "filters": [
          "none; all 32 frozen old-DEV rows"
        ],
        "metric_definitions": [
          "old_pass_retention_rate = old_pass_retained / old_pass_total",
          "known_fail_review_rejection_rate = known_fail_review_rejected / known_fail_review_total",
          "These are DEV diagnostics, not research PASS gates."
        ]
      }
    },
    {
      "id": "head_source",
      "label": "Frozen v8 DEV mismatch counts by memory class",
      "path": "project/data/paper1_authority/paper1_semantic_memory_v8_dev_matrix_20260820_v1.jsonl",
      "query": {
        "engine": "SQLite 3 in-memory audit",
        "sql": "SELECT\n  memory_class,\n  COUNT(*) AS total,\n  SUM(CASE WHEN mismatch_reason = 'MATCH' THEN 1 ELSE 0 END) AS match,\n  SUM(CASE WHEN mismatch_reason = 'SEMANTIC_FALSE_REJECT' THEN 1 ELSE 0 END) AS false_reject,\n  SUM(CASE WHEN mismatch_reason = 'SEMANTIC_FALSE_ACCEPT' THEN 1 ELSE 0 END) AS false_accept,\n  SUM(CASE WHEN mismatch_reason = 'SCHEMA_REJECT' THEN 1 ELSE 0 END) AS schema_reject,\n  SUM(CASE WHEN old_human_label = 'PASS' THEN 1 ELSE 0 END) AS old_pass_total,\n  SUM(CASE WHEN old_human_label IN ('FAIL','REVIEW') THEN 1 ELSE 0 END) AS old_fail_review_total\nFROM v8_dev_matrix\nGROUP BY memory_class\nORDER BY memory_class",
        "description": "Groups the frozen item matrix by MP/ME and mismatch class.",
        "tables_used": [
          "v8_dev_matrix"
        ],
        "filters": [
          "none; MS had no items in the old DEV packet"
        ],
        "metric_definitions": [
          "Each stacked segment is an item count; denominator is shown as total."
        ]
      }
    },
    {
      "id": "item_source",
      "label": "Frozen v8 DEV item-level decisions",
      "path": "project/data/paper1_authority/paper1_semantic_memory_v8_dev_matrix_20260820_v1.jsonl",
      "query": {
        "engine": "SQLite 3 in-memory audit",
        "sql": "SELECT\n  memory_class, memory_id, old_human_label, v7_verdict,\n  deterministic_v8_verdict, mismatch_reason, local_gate_reason\nFROM v8_dev_matrix\nORDER BY memory_class, memory_id",
        "description": "Selects the bounded item-level audit fields for exact review.",
        "tables_used": [
          "v8_dev_matrix"
        ],
        "filters": [
          "no candidate content or new human judgments included"
        ],
        "metric_definitions": []
      }
    }
  ]
